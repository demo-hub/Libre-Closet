{{#*inline "instance"}}
<h2 class="mt-8 mb-2">{{t 'lang.ABOUT_INSTANCE'}}</h2>
<dl class="mb-4 grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-1">
  {{#if operatorName}}
  <dt class="text-graphite">{{t 'lang.ABOUT_RUN_BY'}}</dt>
  <dd class="wrap-anywhere">{{operatorName}}</dd>
  {{/if}}
  {{#if operatorContact}}
  <dt class="text-graphite">{{t 'lang.ABOUT_CONTACT'}}</dt>
  <dd class="wrap-anywhere">{{operatorContact}}</dd>
  {{/if}}
</dl>
{{/inline}}
{{>navbar}}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": {{{json (t 'lang.HOME')}}}, "item": "{{siteUrl}}/"},
      {"@type": "ListItem", "position": 2, "name": {{{json (t 'lang.ABOUT_TITLE')}}}, "item": "{{siteUrl}}/about"}
    ]
  }
</script>

<main id="main" tabindex="-1" class="page page--narrow">
  <h1 class="mb-6">{{t 'lang.ABOUT_HEADING'}}</h1>
  <p class="mb-4">{{t 'lang.ABOUT_INTRO'}}</p>
  <p class="mb-4">{{t 'lang.ABOUT_FORK'}}</p>

  {{#if operatorName}}{{> instance}}{{else if operatorContact}}{{> instance}}{{/if}}

  <h2 class="mt-8 mb-2">{{t 'lang.ABOUT_STORY'}}</h2>
  <p class="mb-4">{{t 'lang.ABOUT_STORY_DESC'}}</p>

  <h2 class="mt-8 mb-2">{{t 'lang.ABOUT_OPEN_SOURCE'}}</h2>
  <p class="mb-4">{{t 'lang.ABOUT_OPEN_SOURCE_DESC'}}</p>

  <h2 class="mt-8 mb-2">{{t 'lang.ABOUT_TECH'}}</h2>
  <p class="mb-4">{{t 'lang.ABOUT_TECH_DESC'}}</p>

  <p class="mt-8 flex flex-wrap gap-x-6">
    <a href="{{sourceUrl}}" target="_blank" rel="noopener" hx-boost="false" class="link link-primary inline-flex min-h-6 items-center pointer-coarse:min-h-11">{{t 'lang.ABOUT_SOURCE'}}</a>
    <a href="https://github.com/Lazztech/Libre-Closet" target="_blank" rel="noopener" hx-boost="false" class="link link-primary inline-flex min-h-6 items-center pointer-coarse:min-h-11">{{t 'lang.ABOUT_UPSTREAM'}}</a>
  </p>
</main>

{{>dock}}

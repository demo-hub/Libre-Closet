{{>navbar}}

<main id="main" tabindex="-1" class="page page--narrow">
  <h1 class="mb-6 hyphens-auto wrap-anywhere">{{pageTitle}}</h1>

  {{#if garment}}
  {{#if garment.photo}}
  <figure class="mx-auto mb-6 aspect-square w-full max-w-sm overflow-hidden rounded-box bg-base-200">
    <img src="/file/nobg/{{garment.photo.fileName}}" alt="{{pageTitle}}" class="size-full object-contain" />
  </figure>
  {{else}}
  <div class="mx-auto mb-6 flex aspect-square w-full max-w-sm items-center justify-center rounded-box bg-base-200">
    {{icon "hanger" class="size-20 text-graphite"}}
  </div>
  {{/if}}
  <div class="card mb-6">
    <dl class="card-body gap-3">
      <div class="flex justify-between gap-4">
        <dt class="text-sm text-graphite">{{t 'lang.CATEGORY'}}</dt>
        <dd class="font-medium text-end wrap-anywhere">{{categoryLabel}}</dd>
      </div>
      {{#if garment.brand}}
      <div class="flex justify-between gap-4">
        <dt class="text-sm text-graphite">{{t 'lang.BRAND'}}</dt>
        <dd class="font-medium text-end wrap-anywhere">{{garment.brand}}</dd>
      </div>
      {{/if}}
    </dl>
  </div>
  {{/if}}

  {{#if outfit}}
  {{#if outfit.notes}}
  <p class="mb-6 whitespace-pre-line text-graphite wrap-anywhere">{{outfit.notes}}</p>
  {{/if}}
  <h2 class="mb-3 text-h3">{{t 'lang.GARMENTS_IN_OUTFIT'}}</h2>
  {{#if garments.length}}
  <ul role="list" class="mb-8 grid grid-cols-3 gap-3 sm:grid-cols-4">
    {{#each garments}}
    <li class="flex flex-col items-center gap-1 text-center">
      {{#if this.photo}}
      <img src="/file/nobg/{{this.photo.fileName}}" alt="" class="aspect-square w-full rounded-box bg-base-200 object-contain" />
      {{else}}
      <span class="flex aspect-square w-full items-center justify-center rounded-box bg-base-200 text-graphite">{{icon "hanger" class="size-8"}}</span>
      {{/if}}
      <span class="line-clamp-2 text-sm hyphens-auto wrap-anywhere">{{this.label}}</span>
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="mb-8 text-graphite">{{t 'lang.NO_GARMENTS_IN_OUTFIT'}}</p>
  {{/if}}
  {{/if}}

  {{#if file}}
  <figure class="mx-auto mb-6 w-full max-w-sm overflow-hidden rounded-box bg-base-200">
    <img src="/file/{{file.fileName}}" alt="{{t 'lang.FILE_PREVIEW_ALT'}}" class="w-full object-contain" />
  </figure>
  {{/if}}

  <p class="text-graphite">{{sharedFrom}}</p>
</main>

{{>dock}}

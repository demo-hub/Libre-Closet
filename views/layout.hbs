<!DOCTYPE html>
{{!-- locale value is for internationalization comes from the nest-i18n module
and is provided globally in the ViewContextMiddleware
https://nestjs-i18n.com/quick-start --}}
<html lang="{{locale}}">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="viewport-fit=cover, width=device-width, initial-scale=1.0"
    />
    {{! https://developer.chrome.com/docs/lighthouse/seo/meta-description }}
    <meta name="description" content="{{ogDescription}}" />
    {{!-- Canonical URL --}}
    <link rel="canonical" href="{{canonicalUrl}}" />
    {{!-- Facebook Open Graph Meta Tags https://ogp.me/ --}}
    <meta property="og:locale" content="{{ogLocale}}" />
    <meta property="og:url" content="{{ogUrl}}" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{{ogTitle}}" />
    <meta property="og:description" content="{{ogDescription}}" />
    <meta property="og:image" content="{{ogImage}}" />
    {{#if ogImageWidth}}
    <meta property="og:image:width" content="{{ogImageWidth}}" />
    <meta property="og:image:height" content="{{ogImageHeight}}" />
    {{/if}}
    {{!-- Twitter Open Graph Meta Tags https://ogp.me/ --}}
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="{{siteUrl}}" />
    <meta property="twitter:url" content="{{ogUrl}}" />
    <meta name="twitter:title" content="{{ogTitle}}" />
    <meta name="twitter:description" content="{{ogDescription}}" />
    <meta name="twitter:image" content="{{ogImage}}" />
    <meta property="og:site_name" content="{{appName}}" />

    {{!-- Static per full load: hx-boost never swaps <head>, and the media attribute switches them. --}}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161d38" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {{!--
    https://developer.apple.com/library/archive/documentation/AppleApplications/Reference/SafariWebContent/ConfiguringWebApplications/ConfiguringWebApplications.html
    https://developer.chrome.com/docs/lighthouse/pwa/apple-touch-icon --}}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {{!-- htmx reads only the first htmx-config meta, so there is exactly one. --}}
    <meta name="htmx-config" content='{"globalViewTransitions": true, "includeIndicatorStyles": false}' />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <title>{{#if pageTitle}}{{pageTitle}}{{else}}{{appName}}{{/if}}</title>
    {{! Used inconjunction with service worker sw.js to enable PWA (Progressive
    Web App) functionality. }}
    <link rel="manifest" href="/manifest.json" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {{! Served modules from node_modules, look to main.ts to see how this is
    performed. https://htmx.org/docs/#installing
    https://blog.wesleyac.com/posts/why-not-javascript-cdn }}
    <script defer src="/modules/htmx.min.js"></script>
    {{!-- Sortable before _hyperscript: deferred scripts run in order, and the outfit builder's init creates it as soon as _hyperscript runs. --}}
    <script defer src="/modules/Sortable.min.js"></script>
    <script defer src="/modules/_hyperscript.min.js"></script>
    <script defer src="/modules/sse.js"></script>
    <script defer src="{{asset '/js/color-multiselect.js'}}"></script>
    {{!-- Built in src/asset-url.ts: it also maps every /js/ module to its build's URL, so the bare imports in templates and scripts never meet an older service worker's precache. --}}
    <script type="importmap">{{{importMap}}}</script>
    {{#if pwaEnabled}}
    <script type="module" src="/modules/pwa-install.bundle.js"></script>
    {{/if}}
    {{! Include assets/main.css and build output from
    TailwindCSS/DaisyUI. Versioned, so an upgrade's first page view cannot
    get the previous release's stylesheet from the service worker. }}
    <link href="{{asset '/bundle.css'}}" rel="preload" as="style" />
    <link href="{{asset '/bundle.css'}}" rel="stylesheet" />
    {{!-- crossorigin, or each font is fetched twice. --}}
    <link rel="preload" href="/assets/fonts/inter-v20-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/plus-jakarta-sans-v12-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script>
      window.KNOWN_COLORS = new Set({{{knownColors}}});
    </script>
    <script>
      if (!window.__lcToastBound) (function () {
        window.__lcToastBound = true;
        document.addEventListener('htmx:responseError', function (e) {
          // A rate limit says to wait rather than that the request failed.
          var limited = e.detail && e.detail.xhr && e.detail.xhr.status === 429;
          var other = document.getElementById(limited ? 'requestErrorToast' : 'rateLimitedToast');
          if (other) other.classList.add('hidden');
          var toast = document.getElementById(limited ? 'rateLimitedToast' : 'requestErrorToast');
          if (!toast) return;
          if (toast.classList.contains('hidden')) return toast.classList.remove('hidden');
          // Already up: hide and re-show so a repeated failure is announced again.
          toast.classList.add('hidden');
          setTimeout(function () { toast.classList.remove('hidden'); }, 100);
        });
        document.addEventListener('htmx:beforeHistorySave', function () {
          document.querySelectorAll('details.dropdown[open], details.color-ms[open]').forEach(function (d) { d.removeAttribute('open'); });
          // A restored snapshot must not keep a toast, a "Copied" label, an open dialog (it would come back non-modal) or values a script wrote into a form.
          document.querySelectorAll('.toast').forEach(function (t) { t.classList.add('hidden'); });
          document.querySelectorAll('[data-copy][data-label] span').forEach(function (s) { s.textContent = s.closest('[data-label]').dataset.label; });
          document.querySelectorAll('dialog[open]').forEach(function (d) { d.close(); });
          document.querySelectorAll('input[data-initial]').forEach(function (i) { i.value = i.dataset.initial; });
          document.querySelectorAll('#photoFileName').forEach(function (p) { p.hidden = true; p.textContent = ''; });
          document.querySelectorAll('#photoBtn').forEach(function (b) { b.disabled = true; });
        });
        // A <details> menu closes only when its own summary is pressed.
        function closeMenusOutside(e) {
          document.querySelectorAll('details.dropdown[open]').forEach(function (d) {
            if (!d.contains(e.target)) d.removeAttribute('open');
          });
        }
        document.addEventListener('click', closeMenusOutside);
        document.addEventListener('focusin', closeMenusOutside);
        document.addEventListener('keydown', function (e) {
          if (e.key !== 'Escape') return;
          document.querySelectorAll('details.dropdown[open]').forEach(function (d) {
            var hadFocus = d.contains(document.activeElement);
            d.removeAttribute('open');
            if (hadFocus) d.querySelector('summary').focus();
          });
        });
        // A live-validation swap brings back the values the request carried; keep what was typed since.
        var typed = null;
        // A validation swap that lands while the submit button is held moves it from under the pointer.
        var pressedForm = null;
        document.addEventListener('pointerdown', function (e) {
          var button = e.target.closest && e.target.closest('[type=submit]');
          pressedForm = button ? button.form : null;
        }, true);
        ['pointerup', 'pointercancel'].forEach(function (type) {
          document.addEventListener(type, function () { setTimeout(function () { pressedForm = null; }); }, true);
        });
        document.addEventListener('htmx:beforeSwap', function (e) {
          typed = null;
          var fs = e.detail.target;
          if (!fs || !fs.hasAttribute || !fs.hasAttribute('data-live-validation')) return;
          if (pressedForm && fs.closest('form') === pressedForm) { e.detail.shouldSwap = false; return; }
          var active = document.activeElement;
          typed = { values: {}, focus: fs.contains(active) ? active.id : null };
          try { typed.start = active.selectionStart; typed.end = active.selectionEnd; } catch (err) {}
          fs.querySelectorAll('input[id]').forEach(function (i) { typed.values[i.id] = i.value; });
        });
        document.addEventListener('htmx:afterSwap', function (e) {
          if (!typed || !e.target.hasAttribute('data-live-validation')) return;
          e.target.querySelectorAll('input[id]').forEach(function (i) {
            if (i.id in typed.values) i.value = typed.values[i.id];
          });
          var el = typed.focus && document.getElementById(typed.focus);
          if (el && typed.start != null) { try { el.setSelectionRange(typed.start, typed.end); } catch (err) {} }
          typed = null;
        });
      })();
    </script>
  </head>

  {{! hx-boost 'automagically' replaces all anchor tags with htmx logic that
  swaps out the body of the html with the response. This results in a smoother
  user experience where the body gets swapped out without a full page reload
  similar to a SPA. https://htmx.org/attributes/hx-boost/
  https://htmx.org/quirks/#some-people-don-t-like-hx-boost }}
  <body
    hx-boost="true"
    hx-ext="sse"
    class="min-h-dvh flex flex-col"
  >
    <a href="#main" class="skip-link">{{t 'lang.SKIP_TO_CONTENT'}}</a>
    {{! Caution: Triple brackets in handlebarsjs disables auto-escaping and may
    pose a XSS risk with HTMX. However the exception to this rule is when
    loading hbs rendered content which is pre-santized by the handlebars
    templatinng engine as it get's rendered.
    https://handlebarsjs.com/guide/expressions.html#literal-segments
    https://htmx.org/essays/web-security-basics-with-htmx/ }} {{{body}}} {{!
    htmx does not swap a 4xx or 5xx response, so without this a refused or
    rate-limited request looks to the user like nothing happened at all. }}
    {{> toast id="requestErrorToast" kind="error" text=(t 'lang.REQUEST_FAILED') hidden=true dismiss=true}}
    {{> toast id="rateLimitedToast" kind="error" text=(t 'lang.ERROR_429') hidden=true dismiss=true}}
    {{! The
    service worker is used in conjunction with the manifest.json to enable PWA
    (Progressive Web App) functionality. This script tag uses JavaScript
    modules, so the proper `type` attribute value is required.
    https://developer.chrome.com/docs/workbox/handling-service-worker-updates }}
    {{#if pwaEnabled}}
    <script type="module">
      // This code sample uses features introduced in Workbox v6.
      import { Workbox } from '/modules/workbox-window.prod.mjs';
      import PullToRefresh from '/modules/pulltorefresh/index.esm.js';

      if ('serviceWorker' in navigator) {
        const wb = new Workbox('/sw.js');

        // When an updated SW takes control of this page (via skipWaiting +
        // clientsClaim), set a flag rather than reloading immediately.
        // Immediate reloads cause a black screen on long-lived htmx-boosted
        // pages because the new SW isn't ready to serve mid-session requests.
        wb.addEventListener('controlling', (event) => {
          if (event.isUpdate) {
            window.__swUpdated = true;
          }
        });

        // On the user's next htmx GET navigation after a SW update, cancel
        // the htmx XHR and do a full page navigation to the destination
        // instead. window.location.reload() would drop the user on the
        // current URL, not where they were trying to go.
        // Non-GET requests (form submits etc.) are passed through — they use
        // NetworkFirst so the SW doesn't cache them and they reach the server
        // regardless of which SW is in control.
        document.addEventListener('htmx:beforeRequest', (event) => {
          if (
            window.__swUpdated &&
            event.detail.requestConfig.boosted &&
            event.detail.requestConfig.verb === 'get'
          ) {
            event.preventDefault();
            // finalRequestPath, not requestConfig.path: a GET form's fields are only in the former.
            window.location.href = event.detail.pathInfo.finalRequestPath;
          }
        });

        // Push is turned on from the profile page, on a press: Firefox and Safari refuse a prompt nobody asked for.
        wb.register().catch((err) => console.warn('Service worker:', err));

        // Signing out forgets this browser's subscription first, while the session can still say whose it is.
        // Capture phase, so this runs before htmx follows the boosted link. Sign-out goes ahead whatever push does.
        if (!window.__lcLogoutBound) {
          window.__lcLogoutBound = true;
          document.addEventListener('click', (event) => {
            const link = event.target.closest && event.target.closest('a[href="/auth/logout"]');
            if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) return;
            event.preventDefault();
            event.stopPropagation();
            const leave = () => window.location.assign('/auth/logout');
            const timeout = new Promise((resolve) => setTimeout(resolve, 3000));
            Promise.race([import('/js/webPush.js').then((m) => m.default.unsubscribe()), timeout])
              .catch((err) => console.warn('Web push:', err))
              .finally(leave);
          }, true);
        }
      }

      // https://stackoverflow.com/questions/75972895/ios-pwa-how-to-re-enable-pull-to-refresh
      // Boosted navigation re-runs this script and replaces <main>, so bind once, on <body>.
      if (window.navigator.standalone === true && !window.__lcPtrBound) {
        window.__lcPtrBound = true;
        const ptr = PullToRefresh.init({
          mainElement: 'body',
          instructionsPullToRefresh: "{{t 'lang.PTR_PULL'}}",
          instructionsReleaseToRefresh: "{{t 'lang.PTR_RELEASE'}}",
          instructionsRefreshing: "{{t 'lang.PTR_REFRESHING'}}",
          onRefresh() {
            location.reload();
          },
        });
        // A swap can take the bar out mid-reset, and the library only rebuilds it once it has let go.
        const dropDetachedBar = () => {
          if (ptr.ptrElement && !ptr.ptrElement.isConnected) ptr.ptrElement = null;
        };
        document.addEventListener('htmx:afterSwap', dropDetachedBar);
        document.addEventListener('htmx:historyRestore', dropDetachedBar);
      }
    </script>
    <pwa-install id="pwa-install" manifest-url="/manifest.json"></pwa-install>
    <script type="text/javascript">
      var pwaInstall = document.getElementById('pwa-install');
    </script>
    {{/if}}
  </body>
</html>

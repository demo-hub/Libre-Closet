{{>navbar}}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": {{{json (t 'lang.HOME')}}}, "item": "{{siteUrl}}/"},
      {"@type": "ListItem", "position": 2, "name": {{{json (t 'lang.PRIVACY_TITLE')}}}, "item": "{{siteUrl}}/privacy"}
    ]
  }
</script>

<main id="main" tabindex="-1" class="page page--narrow">
  <h1 class="mb-6 hyphens-auto wrap-anywhere">{{t 'lang.PRIVACY_HEADING'}}</h1>
  <p class="mb-4">{{t 'lang.PRIVACY_INTRO'}}</p>

  <h2 class="mt-8 mb-2">{{t 'lang.PRIVACY_SELF_HOSTED_DATA_COLLECTED'}}</h2>
  <p class="mb-4">{{t 'lang.PRIVACY_SELF_HOSTED_DATA_ITEMS'}}</p>

  <h2 class="mt-8 mb-2">{{t 'lang.PRIVACY_SELF_HOSTED_DATA_STORAGE'}}</h2>
  <p class="mb-4">{{t 'lang.PRIVACY_SELF_HOSTED_DATA_STORAGE_DESC'}}</p>
  {{#unless authEnabled}}
  <p class="mb-4">{{t 'lang.PRIVACY_NO_ACCOUNTS'}}</p>
  {{/unless}}

  <h2 class="mt-8 mb-2">{{t 'lang.PRIVACY_SELF_HOSTED_THIRD_PARTY'}}</h2>
  <p class="mb-4">{{t 'lang.PRIVACY_SELF_HOSTED_THIRD_PARTY_DESC'}}</p>
  {{#if importUrlEnabled}}
  <p class="mb-4">{{t 'lang.PRIVACY_SELF_HOSTED_IMPORT_DESC'}}</p>
  {{/if}}
  {{#if authEnabled}}
  <p class="mb-4">{{t 'lang.PRIVACY_EMAIL_DESC'}}</p>
  {{/if}}
  {{#if aiEnabled}}
  <p class="mb-4">{{t 'lang.PRIVACY_AI_DESC'}}</p>
  <p class="mb-4">{{t 'lang.PRIVACY_AI_DESC_2'}}</p>
  {{/if}}

  <h2 class="mt-8 mb-2">{{t 'lang.PRIVACY_SELF_HOSTED_RIGHTS'}}</h2>
  <p class="mb-4">{{t 'lang.PRIVACY_SELF_HOSTED_RIGHTS_DESC'}}</p>

  <h2 class="mt-8 mb-2">{{t 'lang.PRIVACY_CONTACT'}}</h2>
  {{> instanceContact fallback=(t 'lang.PRIVACY_CONTACT_DESC')}}
</main>

{{>dock}}

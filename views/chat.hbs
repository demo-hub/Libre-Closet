{{>navbar}}
<main id="main" tabindex="-1" class="page flex h-[calc(100dvh-var(--spacing-header))] flex-col gap-4">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h1>{{t 'lang.CHAT'}}</h1>
    {{#if user}}
    <button
      type="button"
      hx-post="/notification/test"
      hx-indicator="#loading"
      hx-swap="none"
      class="btn btn-outline btn-sm h-auto min-h-(--size) max-w-full py-1.5"
    >{{t 'lang.TEST_WEB_PUSH'}}</button>
    {{/if}}
  </div>

  <div class="min-h-0 flex-1 overflow-y-auto">
    <div id="chat" role="log" class="flex flex-col"></div>
  </div>
  <div
    id="sse-listener"
    hx-ext="sse"
    sse-connect="/sse"
    sse-swap="message"
    hx-swap="beforeend"
    hx-target="#chat"
  ></div>

  <form
    id="messageForm"
    hx-post="/message"
    hx-indicator="#loading"
    hx-trigger="submit"
    hx-swap="none"
    hx-on::before-request="this.reset()"
    class="flex gap-2"
  >
    <label for="message" class="sr-only">{{t 'lang.MESSAGE_LABEL'}}</label>
    <input
      type="text"
      id="message"
      name="message"
      class="input min-w-0 grow"
      placeholder="{{t 'lang.YOUR_MESSAGE'}}"
      autocomplete="off"
      required
    />
    <button type="submit" class="btn btn-primary">{{t 'lang.SEND'}}</button>
  </form>
</main>
{{>dock}}

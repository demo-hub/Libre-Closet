{{>navbar}}

<main id="main" tabindex="-1" class="page">
  <h1 class="sr-only">{{t 'lang.CALENDAR_PAGE_TITLE'}}</h1>

  <div id="week-grid" class="grid grid-cols-1 gap-3 min-[400px]:grid-cols-2 lg:grid-cols-[20rem_repeat(3,minmax(0,1fr))]">

    <details id="cal-month" class="cal-month group relative col-span-full self-start open:pb-2 lg:col-span-1 lg:row-span-3"{{#if monthOpen}} open{{/if}}>
      <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-box px-3 font-medium group-open:me-22 [&::-webkit-details-marker]:hidden">
        <span id="cal-month-label">{{monthLabel}}</span>
        {{icon "chevron-right" class="size-5 shrink-0 rotate-90 group-open:-rotate-90"}}
      </summary>
      {{!-- Beside the summary, not in it: a link inside a summary is nested interactive content. --}}
      {{!-- The month and day links keep stable ids: htmx gives focus back by id after a boosted navigation. --}}
      <div class="absolute end-0 top-0 flex">
        <a id="cal-prev-month" href="/calendar?week={{prevMonthWeekParam}}&calMonth={{prevMonthParam}}" class="btn btn-ghost btn-circle" aria-label="{{t 'lang.PREVIOUS_MONTH'}}">{{icon "chevron-left" class="size-5"}}</a>
        <a id="cal-next-month" href="/calendar?week={{nextMonthWeekParam}}&calMonth={{nextMonthParam}}" class="btn btn-ghost btn-circle" aria-label="{{t 'lang.NEXT_MONTH'}}">{{icon "chevron-right" class="size-5"}}</a>
      </div>
      <table class="w-full table-fixed" aria-labelledby="cal-month-label">
        <thead>
          <tr>
            {{#each weekdays}}
            <th scope="col" class="pb-1 text-sm font-medium text-graphite"><span aria-hidden="true">{{this.letter}}</span><span class="sr-only">{{this.name}}</span></th>
            {{/each}}
          </tr>
        </thead>
        <tbody>
          {{#each calendarWeeks}}
          <tr>
            {{#each this.days}}
            <td class="p-0">
              <a id="cal-day-{{this.dateParam}}" href="/calendar?week={{this.dateParam}}#day-{{this.dateParam}}" aria-label="{{this.label}}"{{#if this.isToday}} aria-current="date"{{/if}} class="mx-auto flex aspect-square w-full max-w-11 items-center justify-center rounded-full text-sm {{this.calCellClass}}">{{this.dayNum}}</a>
            </td>
            {{/each}}
          </tr>
          {{/each}}
        </tbody>
      </table>
    </details>
    {{!-- htmx runs this again on a page restored from history, which must keep the month as the user left it. --}}
    <script>{ const month = document.getElementById('cal-month'); if (!month.dataset.ready) { month.dataset.ready = 'true'; if (matchMedia('(min-width: 64rem)').matches) month.open = true; } }</script>

    {{#each days}}
    <div role="group" aria-labelledby="day-{{this.dateParam}}" class="flex flex-col gap-2 rounded-box border border-base-300 bg-base-100 p-3">
      <h2 id="day-{{this.dateParam}}" class="flex flex-wrap items-center gap-x-1.5 gap-y-1 font-sans"{{#if this.isToday}} aria-current="date"{{/if}}{{#if this.focus}} tabindex="-1" autofocus{{/if}}>
        <span class="text-sm font-medium text-graphite">{{this.dayName}}</span>
        <span class="text-sm font-semibold tabular-nums">{{this.dayNum}}</span>
        {{#if this.isToday}}<span class="badge">{{t 'lang.TODAY'}}</span>{{/if}}
      </h2>

      {{#each this.entries}}
      <div class="cal-chip" role="group" aria-labelledby="cal-entry-{{this.id}}-name">
        <a class="cal-chip__main" href="/outfits/{{this.outfit.id}}/edit?returnTo=/calendar&returnToWeek={{../dateParam}}">
          <span class="flex items-center" aria-hidden="true">
            {{#each this.outfit.thumbnails}}
            {{#if this}}
            <img src="/file/nobg/{{this}}" alt="" class="cal-chip__thumb object-contain" />
            {{else}}
            <span class="cal-chip__thumb text-graphite">{{icon "hanger" class="size-5"}}</span>
            {{/if}}
            {{else}}
            <span class="cal-chip__thumb text-graphite">{{icon "hanger" class="size-5"}}</span>
            {{/each}}
            {{#if this.outfit.moreGarments}}<span class="ms-1.5 text-sm text-graphite">+{{this.outfit.moreGarments}}</span>{{/if}}
          </span>
          <span id="cal-entry-{{this.id}}-name" class="cal-chip__name font-medium hyphens-auto wrap-anywhere">{{#if this.outfit.name}}{{this.outfit.name}}{{else}}{{t 'lang.UNTITLED_OUTFIT'}}{{/if}}</span>
        </a>
        <div class="flex flex-wrap items-center gap-2">
          {{> calendar_worn_button entryId=this.id week=../dateParam worn=this.worn}}
          <form method="post" action="/calendar/{{this.id}}/delete" class="ms-auto"
            hx-post="/calendar/{{this.id}}/delete" hx-confirm="{{t 'lang.CALENDAR_DELETE_CONFIRM'}}">
            <input type="hidden" name="week" value="{{../dateParam}}" />
            <button type="submit" class="btn btn-ghost btn-circle" aria-label="{{t 'lang.REMOVE_FROM_CALENDAR'}}">{{icon "x-mark" class="size-5"}}</button>
          </form>
        </div>
      </div>
      {{/each}}

      <a href="/outfits/new?scheduleDate={{this.dateParam}}&returnTo=/calendar" class="btn btn-ghost mt-auto h-auto min-h-11 self-start py-2 text-start">{{icon "plus" class="size-5"}}{{t 'lang.BUILD_OUTFIT'}}</a>
    </div>
    {{/each}}

  </div>

</main>

{{>dock}}

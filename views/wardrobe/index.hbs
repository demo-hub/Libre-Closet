{{>navbar}}

<main id="main" tabindex="-1" class="page">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <h1>{{t 'lang.WARDROBE'}}</h1>
    {{#if newGarmentHref}}{{#unless emptyWardrobe}}
    <a href="{{newGarmentHref}}" class="btn btn-primary">{{icon "plus" class="size-5"}}{{t 'lang.NEW_GARMENT'}}</a>
    {{/unless}}{{/if}}
  </div>

  {{#if sharedWardrobes.length}}
  <div class="mb-4">
    <label for="wardrobe-switcher" class="sr-only">{{t 'lang.WARDROBE_SWITCHER'}}</label>
    <select id="wardrobe-switcher" class="select w-full sm:max-w-sm" autocomplete="off" onchange="location.href=this.value">
      <option value="/wardrobe" {{#unless viewOwner}}selected{{/unless}}>{{t 'lang.MY_WARDROBE'}}</option>
      {{#each sharedWardrobes}}
      <option value="/wardrobe?ownerId={{this.grantorId}}" {{#ifEquals ../viewOwner this.grantorId}}selected{{/ifEquals}}>{{this.grantorName}} ({{#ifEquals this.permission 'VIEW'}}{{t 'lang.PERMISSION_VIEW'}}{{else}}{{t 'lang.PERMISSION_MANAGE'}}{{/ifEquals}})</option>
      {{/each}}
    </select>
  </div>
  {{/if}}

  <form method="get" action="/wardrobe" id="search-form" role="search" class="flex w-full max-w-xl gap-2 mb-3">
    <input type="hidden" name="category" id="active-category" value="{{search.category}}">
    <input type="hidden" name="color" id="active-color" value="{{search.color}}">
    <input type="hidden" name="size" id="active-size" value="{{search.size}}">
    <input type="hidden" name="archived" id="active-archived" value="{{#if showArchived}}true{{/if}}">
    {{#if viewOwner}}<input type="hidden" name="ownerId" value="{{viewOwner}}">{{/if}}
    <label for="wardrobe-keyword" class="sr-only">{{t 'lang.SEARCH_PLACEHOLDER'}}</label>
    <input id="wardrobe-keyword" type="search" name="keyword" value="{{search.keyword}}" placeholder="{{t 'lang.SEARCH_PLACEHOLDER'}}" enterkeyhint="search" class="input flex-1 min-w-0">
    <button type="submit" class="btn btn-outline">{{t 'lang.SEARCH'}}</button>
  </form>

  <div class="flex flex-wrap items-center gap-2 mb-4">
    {{!-- Close is focused explicitly: WebKit drops focus on the first keyboard opening, and Chromium would pick the scrollable box. --}}
    <button id="filter-button" type="button" class="btn btn-outline" aria-haspopup="dialog" _="on click call #filter-modal.showModal() then call #filter-close.focus()">{{icon "funnel" class="size-5"}}{{t 'lang.FILTERS'}}</button>
    {{#each activeFilters}}
    <a href="{{this.href}}" class="badge gap-1 min-h-11 h-auto px-3 max-w-full wrap-anywhere" aria-label="{{t 'lang.REMOVE_FILTER'}}: {{#if this.facet}}{{this.facet}}: {{/if}}{{this.value}}">
      <span>{{#if this.facet}}{{this.facet}}: {{/if}}<span{{#if this.capitalize}} class="capitalize"{{/if}}>{{this.value}}</span></span>
      {{icon "x-mark" class="size-4 shrink-0"}}
    </a>
    {{/each}}
  </div>

  {{#if garments.length}}
  <p class="text-sm text-graphite mb-3">{{garments.length}} {{t 'lang.RESULTS'}}</p>
  <ul role="list" class="grid grid-cols-2 min-[480px]:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3">
    {{#each garments}}
    <li>
      <a href="/wardrobe/{{this.id}}{{#if ../viewOwner}}?ownerId={{../viewOwner}}{{/if}}" class="card h-full hover:border-steel">
        <figure class="aspect-square bg-base-200">
          {{#if this.photo}}
          <img src="/file/nobg/{{this.photo.fileName}}" alt="" class="size-full object-contain{{#if this.archived}} opacity-70{{/if}}" />
          {{else}}
          {{icon "hanger" class="size-12 text-graphite"}}
          {{/if}}
        </figure>
        <div class="card-body p-3 gap-1">
          <p class="card-title text-base font-semibold wrap-anywhere">{{this.name}}</p>
          <p class="text-sm text-graphite wrap-anywhere">{{lookup ../categoryLabels this.category}}</p>
        </div>
        {{#if this.archived}}<span class="badge bg-base-100 absolute top-2 start-2">{{t 'lang.ARCHIVED'}}</span>{{/if}}
      </a>
    </li>
    {{/each}}
  </ul>
  {{else if filtered}}
  {{> empty icon="magnifying-glass" text=(t 'lang.NO_MATCHES') href=clearFiltersHref cta=(t 'lang.CLEAR_FILTERS')}}
  {{else}}
  {{> empty icon="hanger" text=(t 'lang.NO_GARMENTS') href=newGarmentHref cta=(t 'lang.ADD_FIRST_GARMENT')}}
  {{/if}}
</main>

<dialog id="filter-modal" class="modal modal-bottom sm:modal-middle" aria-labelledby="filter-modal-title">
  <div class="modal-box p-0">
    <div class="sticky top-0 z-1 flex items-center justify-between gap-2 bg-base-100 px-6 pt-4 pb-2">
      <h2 id="filter-modal-title" class="text-h3">{{t 'lang.FILTERS'}}</h2>
      <form method="dialog">
        <button id="filter-close" class="btn btn-ghost btn-circle" aria-label="{{t 'lang.CLOSE'}}">{{icon "x-mark" class="size-5"}}</button>
      </form>
    </div>

    <div class="grid gap-5 px-6 py-2">
      {{!-- peer-focus, not peer-focus-visible: WebKit drops :focus-visible when arrow keys move between radios. --}}
      <fieldset>
        <legend class="mb-2 text-sm font-medium text-graphite">{{t 'lang.CATEGORY'}}</legend>
        <div class="flex flex-wrap gap-2">
          {{#each availableCategories}}
          <label class="group cursor-pointer">
            <input type="radio" name="modal-category" value="{{this.value}}" class="sr-only peer" {{#ifEquals this.value ../search.category}}checked{{/ifEquals}}>
            <span class="badge badge-outline gap-1 min-h-11 h-auto px-3 wrap-anywhere select-none peer-checked:bg-primary peer-checked:text-primary-content peer-checked:border-primary peer-checked:font-semibold peer-focus:outline-2 peer-focus:outline-offset-2 peer-focus:outline-focus">{{icon "check" class="size-4 shrink-0 hidden group-has-checked:inline"}}{{this.label}}</span>
          </label>
          {{/each}}
        </div>
      </fieldset>

      <fieldset>
        <legend class="mb-2 text-sm font-medium text-graphite">{{t 'lang.COLOR'}}</legend>
        <div class="flex flex-wrap gap-2">
          {{#each colors}}
          <label class="group cursor-pointer">
            <input type="radio" name="modal-color" value="{{this}}" class="sr-only peer" {{#ifEquals this ../search.color}}checked{{/ifEquals}}>
            <span class="badge badge-outline gap-1 min-h-11 h-auto px-3 capitalize select-none peer-checked:bg-primary peer-checked:text-primary-content peer-checked:border-primary peer-checked:font-semibold peer-focus:outline-2 peer-focus:outline-offset-2 peer-focus:outline-focus">{{icon "check" class="size-4 shrink-0 hidden group-has-checked:inline"}}{{this}}</span>
          </label>
          {{/each}}
        </div>
      </fieldset>

      {{#if availableSizes.length}}
      <fieldset>
        <legend class="mb-2 text-sm font-medium text-graphite">{{t 'lang.SIZE'}}</legend>
        <div class="flex flex-wrap gap-2">
          {{#each availableSizes}}
          <label class="group cursor-pointer">
            <input type="radio" name="modal-size" value="{{this}}" class="sr-only peer" {{#ifEquals this ../search.size}}checked{{/ifEquals}}>
            <span class="badge badge-outline gap-1 min-h-11 h-auto px-3 wrap-anywhere select-none peer-checked:bg-primary peer-checked:text-primary-content peer-checked:border-primary peer-checked:font-semibold peer-focus:outline-2 peer-focus:outline-offset-2 peer-focus:outline-focus">{{icon "check" class="size-4 shrink-0 hidden group-has-checked:inline"}}{{this}}</span>
          </label>
          {{/each}}
        </div>
      </fieldset>
      {{/if}}

      <fieldset>
        <legend class="mb-2 text-sm font-medium text-graphite">{{t 'lang.ARCHIVED'}}</legend>
        <label class="flex min-h-11 cursor-pointer items-center gap-3">
          <input type="checkbox" name="modal-archived" value="true" class="checkbox" {{#if showArchived}}checked{{/if}}>
          <span>{{t 'lang.SHOW_ARCHIVED'}}</span>
        </label>
      </fieldset>
    </div>

    <div class="modal-action sticky bottom-0 m-0 bg-base-100 px-6 py-4">
      <button type="button"
        class="btn btn-outline"
        _="on click
          for el in <input[name='modal-category']/>
            set el.checked to false
          end
          for el in <input[name='modal-color']/>
            set el.checked to false
          end
          for el in <input[name='modal-size']/>
            set el.checked to false
          end
          for el in <input[name='modal-archived']/>
            set el.checked to false
          end
          set #active-category.value to ''
          set #active-color.value to ''
          set #active-size.value to ''
          set #active-archived.value to ''
          call #filter-modal.close()
          call #search-form.requestSubmit()">
        {{t 'lang.CLEAR_FILTERS'}}
      </button>
      <button type="button"
        class="btn btn-primary"
        _="on click
          set category to ''
          get the first <input[name='modal-category']:checked/>
          if it then set category to it.value end
          set color to ''
          get the first <input[name='modal-color']:checked/>
          if it then set color to it.value end
          set size to ''
          get the first <input[name='modal-size']:checked/>
          if it then set size to it.value end
          set archived to ''
          get the first <input[name='modal-archived']:checked/>
          if it then set archived to 'true' end
          set #active-category.value to category
          set #active-color.value to color
          set #active-size.value to size
          set #active-archived.value to archived
          call #filter-modal.close()
          call #search-form.requestSubmit()">
        {{t 'lang.APPLY_FILTERS'}}
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button tabindex="-1">{{t 'lang.CLOSE'}}</button>
  </form>
</dialog>

{{>dock}}

{{>navbar}}

<main id="main" tabindex="-1" class="page page--narrow">
  <div class="flex items-center gap-2 mb-6">
    <a href="/wardrobe{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}" class="btn btn-ghost btn-circle" aria-label="{{t 'lang.BACK'}}">{{icon "arrow-left" class="size-5"}}</a>
    <h1 class="flex-1 min-w-0 wrap-anywhere">{{#if garment.name}}{{garment.name}}{{else}}{{categoryLabel}}{{/if}}</h1>
    {{#if garment.archived}}<span class="badge">{{t 'lang.ARCHIVED'}}</span>{{/if}}
  </div>

  {{#if garment.photo}}
  <figure class="relative mx-auto mb-6 aspect-square w-full max-w-sm overflow-hidden rounded-box bg-base-200">
    <img src="/file/nobg/{{garment.photo.fileName}}" alt="{{#if garment.name}}{{garment.name}}{{else}}{{categoryLabel}}{{/if}}" class="size-full object-contain" />
    {{#if canEdit}}
    <button id="editMaskBtn" type="button" class="btn btn-ghost btn-circle absolute top-2 end-2 bg-base-100" aria-label="{{t 'lang.EDIT_MASK'}}">{{icon "pencil" class="size-5"}}</button>
    {{/if}}
  </figure>
  {{else}}
  <div class="mx-auto mb-6 flex aspect-square w-full max-w-sm items-center justify-center rounded-box bg-base-200">
    {{icon "hanger" class="size-20 text-graphite"}}
  </div>
  {{/if}}

  {{#if canEdit}}
  <form
    hx-post="/wardrobe/{{garment.id}}/photo{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}"
    hx-encoding="multipart/form-data"
    hx-indicator="#photoLoading"
    hx-target="main"
    hx-select="main"
    hx-swap="outerHTML"
    class="flex flex-col gap-2 mb-6"
  >
    {{#if garment.photo}}
    {{> photoPicker submitLabel=(t 'lang.UPDATE_PHOTO')}}
    {{else}}
    {{> photoPicker submitLabel=(t 'lang.ADD_PHOTO')}}
    {{/if}}
  </form>
  <script type="module">
    import { wireUpEditMaskBtn, isBgRemovalEnabled } from '/js/background-removal.js';
    {{#if garment.photo}}
    wireUpEditMaskBtn('{{garment.photo.fileName}}', {{garment.id}}, {{#if viewOwner}}{{viewOwner}}{{else}}null{{/if}});
    if (!isBgRemovalEnabled()) {
      document.getElementById('editMaskBtn')?.style.setProperty('display', 'none');
    }
    {{/if}}
  </script>
  {{/if}}

  <div class="card mb-6">
    <dl class="card-body gap-3">
      <div class="flex justify-between gap-4">
        <dt class="text-sm text-graphite">{{t 'lang.CATEGORY'}}</dt>
        <dd class="font-medium text-end wrap-anywhere">{{categoryLabel}}</dd>
      </div>
      {{#if garment.brand}}
      <div class="flex justify-between gap-4">
        <dt class="text-sm text-graphite">{{t 'lang.BRAND'}}</dt>
        <dd class="font-medium text-end wrap-anywhere">{{garment.brand}}</dd>
      </div>
      {{/if}}
      {{#if garment.size}}
      <div class="flex justify-between gap-4">
        <dt class="text-sm text-graphite">{{t 'lang.SIZE'}}</dt>
        <dd class="font-medium text-end wrap-anywhere">{{garment.size}}</dd>
      </div>
      {{/if}}
      {{#if garment.color}}
      <div class="flex justify-between gap-4">
        <dt class="text-sm text-graphite">{{t 'lang.COLOR'}}</dt>
        <dd class="font-medium text-end capitalize wrap-anywhere">{{formatColors garment.color}}</dd>
      </div>
      {{/if}}
      {{#if garment.dateAquired}}
      <div class="flex justify-between gap-4">
        <dt class="text-sm text-graphite">{{t 'lang.DATE_AQUIRED'}}</dt>
        <dd class="font-medium text-end"><time datetime="{{formatDate garment.dateAquired}}">{{formatDateLong garment.dateAquired}}</time></dd>
      </div>
      {{/if}}
      {{#if garment.washingDetails}}
      <div class="grid gap-1">
        <dt class="text-sm text-graphite">{{t 'lang.WASHING_DETAILS'}}</dt>
        <dd class="whitespace-pre-line wrap-anywhere">{{garment.washingDetails}}</dd>
      </div>
      {{/if}}
      {{#if garment.notes}}
      <div class="grid gap-1">
        <dt class="text-sm text-graphite">{{t 'lang.NOTES'}}</dt>
        <dd class="whitespace-pre-line wrap-anywhere">{{garment.notes}}</dd>
      </div>
      {{/if}}
      {{#if sourceHost}}
      <div class="flex justify-between gap-4">
        <dt class="text-sm text-graphite">{{t 'lang.IMPORTED_FROM'}}</dt>
        <dd class="min-w-0 text-end"><a href="{{garment.sourceUrl}}" target="_blank" rel="noopener noreferrer nofollow" hx-boost="false" class="link link-primary block truncate">{{sourceHost}}</a></dd>
      </div>
      {{/if}}
    </dl>
  </div>

  {{#if canEdit}}
  <div class="grid gap-2 mb-6 sm:grid-cols-3">
    <a href="/wardrobe/{{garment.id}}/edit{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}" class="btn btn-outline">{{icon "pencil" class="size-5"}}{{t 'lang.EDIT'}}</a>
    {{#if canClone}}
    <a href="/wardrobe/{{garment.id}}/clone{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}" class="btn btn-outline">{{t 'lang.CLONE_GARMENT'}}</a>
    {{/if}}
    <button
      type="button"
      class="btn btn-outline"
      data-copy="{{siteUrl}}/share?shareableId={{garment.shareableId}}&type=garment"
      data-done="{{t 'lang.COPIED'}}"
      data-label="{{t 'lang.SHARE'}}"
      _="on click
           call navigator.clipboard.writeText(my @data-copy)
           put my @data-done into the first <span/> in me
           remove .hidden from #copied-toast
           wait 2s
           put my @data-label into the first <span/> in me
           add .hidden to #copied-toast"
    >{{icon "share" class="size-5"}}<span>{{t 'lang.SHARE'}}</span></button>
  </div>
  {{/if}}

  {{#if canDelete}}
  <div class="grid gap-2 sm:grid-cols-2">
    <button
      type="button"
      class="btn btn-outline"
      hx-post="/wardrobe/{{garment.id}}/archive"
      hx-confirm="{{#if garment.archived}}{{t 'lang.CONFIRM_UNARCHIVE'}}{{else}}{{t 'lang.CONFIRM_ARCHIVE'}}{{/if}}"
      hx-indicator="#loading"
    >{{#if garment.archived}}{{t 'lang.UNARCHIVE'}}{{else}}{{t 'lang.ARCHIVE'}}{{/if}}</button>
    <button
      type="button"
      class="btn btn-outline"
      hx-delete="/wardrobe/{{garment.id}}"
      hx-confirm="{{t 'lang.CONFIRM_DELETE'}}"
      hx-indicator="#loading"
    >{{icon "trash" class="size-5"}}{{t 'lang.DELETE_GARMENT'}}</button>
  </div>
  {{/if}}
  {{> maskEditor}}
</main>

{{#if justCreated}}{{> toast id="garment-saved-toast" kind="success" text=(t 'lang.GARMENT_SAVED')}}{{/if}}
{{#if justSavedPhoto}}{{> toast id="photo-saved-toast" kind="success" text=(t 'lang.PHOTO_SAVED')}}{{/if}}
{{#if canEdit}}{{> toast id="copied-toast" kind="success" text=(t 'lang.COPIED') hidden=true}}{{/if}}
<script>
  {{! Strip the one-shot save flags so refreshing or sharing this URL doesn't replay the toast }}
  var savedFlagUrl = new URL(window.location.href);
  if (savedFlagUrl.searchParams.has('created') || savedFlagUrl.searchParams.has('photoSaved')) {
    savedFlagUrl.searchParams.delete('created');
    savedFlagUrl.searchParams.delete('photoSaved');
    window.history.replaceState({}, '', savedFlagUrl);
  }
</script>

{{>dock}}

{{>navbar}}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": {{{json (t 'lang.HOME')}}}, "item": "{{siteUrl}}/"},
      {"@type": "ListItem", "position": 2, "name": {{{json (t 'lang.TERMS_TITLE')}}}, "item": "{{siteUrl}}/terms"}
    ]
  }
</script>

<main id="main" tabindex="-1" class="page page--narrow">
  <h1 class="mb-6 hyphens-auto wrap-anywhere">{{t 'lang.TERMS_HEADING'}}</h1>
  <p class="mb-4">{{t 'lang.TERMS_INTRO'}}</p>

  <h2 class="mt-8 mb-2">{{t 'lang.TERMS_SERVICE'}}</h2>
  <p class="mb-4">{{t 'lang.TERMS_SERVICE_DESC'}}</p>

  <h2 class="mt-8 mb-2">{{t 'lang.TERMS_LICENSE'}}</h2>
  <p class="mb-4">{{t 'lang.TERMS_LICENSE_DESC'}}</p>
  <p class="mb-4">
    <a href="{{sourceUrl}}" target="_blank" rel="noopener" hx-boost="false" class="link link-primary inline-flex min-h-6 items-center pointer-coarse:min-h-11">{{t 'lang.SOURCE_CODE'}}</a>
  </p>

  <h2 class="mt-8 mb-2">{{t 'lang.TERMS_NO_WARRANTY'}}</h2>
  <p class="mb-4">{{t 'lang.TERMS_NO_WARRANTY_DESC'}}</p>

  <h2 class="mt-8 mb-2">{{t 'lang.TERMS_CONTACT'}}</h2>
  {{> instanceContact fallback=(t 'lang.TERMS_CONTACT_DESC')}}
</main>

{{>dock}}

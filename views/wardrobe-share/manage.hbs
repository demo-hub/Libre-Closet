{{>navbar}}

<main id="main" tabindex="-1" class="page page--narrow">
  <h1 class="mb-6">{{t 'lang.WARDROBE_SHARING'}}</h1>

  {{#if error}}
  <div class="mb-6">{{> alert kind="error" text=error focus=true}}</div>
  {{/if}}

  <section class="card mb-6">
    <div class="card-body gap-4">
      <h2 class="card-title">{{t 'lang.SHARE_WARDROBE'}}</h2>
      <p class="text-graphite">{{t 'lang.SHARE_WARDROBE_DESC'}}</p>
      <form
        method="post"
        action="/wardrobe-share/create-invite-link"
        hx-post="/wardrobe-share/create-invite-link"
        hx-target="main"
        hx-select="main"
        hx-swap="outerHTML"
        class="flex flex-wrap items-end gap-3"
      >
        <div class="grid gap-1">
          <label class="label" for="invite-permission">{{t 'lang.ACCESS'}}</label>
          <select id="invite-permission" name="permission" class="select">
            <option value="VIEW">{{t 'lang.PERMISSION_VIEW'}}</option>
            <option value="MANAGE"{{#ifEquals permission 'MANAGE'}} selected{{/ifEquals}}>{{t 'lang.PERMISSION_MANAGE'}}</option>
          </select>
        </div>
        <button id="create-invite" type="submit" class="btn btn-primary h-auto min-h-(--size) max-w-full py-2">{{t 'lang.CREATE_INVITE_LINK'}}</button>
      </form>
      {{#if inviteUrl}}
      <div class="grid gap-1">
        <label class="label" for="new-invite-link">{{t 'lang.INVITE_LINK'}}</label>
        <div class="flex flex-wrap gap-2">
          <input id="new-invite-link" type="text" class="input min-w-0 grow" value="{{inviteUrl}}" readonly autofocus _="on click call me.select()" />
          <button
            type="button"
            class="btn btn-outline h-auto min-h-(--size) max-w-full py-2"
            aria-live="polite"
            data-copy="{{inviteUrl}}"
            data-done="{{t 'lang.COPIED'}}"
            data-label="{{t 'lang.COPY_INVITE_LINK'}}"
            _="on click
                 call navigator.clipboard.writeText(my @data-copy)
                 put my @data-done into the first <span/> in me
                 wait 2s
                 put my @data-label into the first <span/> in me"
          >{{icon "link" class="size-5"}}<span>{{t 'lang.COPY_INVITE_LINK'}}</span></button>
        </div>
      </div>
      {{/if}}
    </div>
  </section>

  {{#if outbound.length}}
  <section class="card mb-6">
    <div class="card-body gap-2">
      <h2 class="card-title">{{t 'lang.YOUR_SHARED_WARDROBES'}}</h2>
      <ul role="list" class="divide-y divide-base-300">
        {{#each outbound}}
        <li class="grid gap-3 py-4 last:pb-0">
          <div class="flex flex-wrap items-center gap-2">
            <span id="outbound-{{this.id}}" class="font-medium wrap-anywhere">{{#if this.grantee}}{{this.grantee.email}}{{else}}{{t 'lang.PENDING_INVITE'}}{{/if}}</span>
            <span class="badge">{{#ifEquals this.permission 'MANAGE'}}{{t 'lang.PERMISSION_MANAGE'}}{{else}}{{t 'lang.PERMISSION_VIEW'}}{{/ifEquals}}</span>
            {{#if this.grantee}}{{#unless this.acceptedAt}}<span class="badge">{{t 'lang.PENDING'}}</span>{{/unless}}{{/if}}
          </div>
          {{#if this.inviteToken}}
          <div class="grid gap-1">
            <label class="label" for="invite-link-{{this.id}}">{{t 'lang.INVITE_LINK'}}</label>
            <input id="invite-link-{{this.id}}" type="text" class="input input-sm w-full" value="{{../baseUrl}}/wardrobe-share/invite/{{this.inviteToken}}" readonly _="on click call me.select()" />
          </div>
          {{/if}}
          <div class="flex flex-wrap gap-2">
            {{#if this.inviteToken}}
            <button
              type="button"
              class="btn btn-outline btn-sm h-auto min-h-(--size) max-w-full py-1.5"
              aria-live="polite"
              aria-describedby="outbound-{{this.id}}"
              data-copy="{{../baseUrl}}/wardrobe-share/invite/{{this.inviteToken}}"
              data-done="{{t 'lang.COPIED'}}"
              data-label="{{t 'lang.COPY_INVITE_LINK'}}"
              _="on click
                   call navigator.clipboard.writeText(my @data-copy)
                   put my @data-done into the first <span/> in me
                   wait 2s
                   put my @data-label into the first <span/> in me"
            >{{icon "link" class="size-4"}}<span>{{t 'lang.COPY_INVITE_LINK'}}</span></button>
            {{/if}}
            <form method="post" action="/wardrobe-share/{{this.id}}/remove"{{#if this.grantee}} hx-confirm="{{t 'lang.REVOKE_CONFIRM'}}"{{/if}}>
              <button type="submit" class="btn btn-outline btn-sm h-auto min-h-(--size) max-w-full py-1.5" aria-describedby="outbound-{{this.id}}">{{icon "trash" class="size-4"}}{{#if this.grantee}}{{t 'lang.REVOKE'}}{{else}}{{t 'lang.REVOKE_INVITE'}}{{/if}}</button>
            </form>
          </div>
        </li>
        {{/each}}
      </ul>
    </div>
  </section>
  {{/if}}

  {{#if pending.length}}
  <section class="card mb-6">
    <div class="card-body gap-2">
      <h2 class="card-title">{{t 'lang.PENDING_INVITES'}}</h2>
      <ul role="list" class="divide-y divide-base-300">
        {{#each pending}}
        <li class="grid gap-3 py-4 last:pb-0">
          <div class="flex flex-wrap items-center gap-2">
            <span id="pending-{{this.id}}" class="font-medium wrap-anywhere">{{this.grantor.email}}</span>
            <span class="badge">{{#ifEquals this.permission 'MANAGE'}}{{t 'lang.PERMISSION_MANAGE'}}{{else}}{{t 'lang.PERMISSION_VIEW'}}{{/ifEquals}}</span>
          </div>
          <div class="flex flex-wrap gap-2">
            <form method="post" action="/wardrobe-share/invite/{{this.inviteToken}}/accept">
              <button type="submit" class="btn btn-primary btn-sm h-auto min-h-(--size) max-w-full py-1.5" aria-describedby="pending-{{this.id}}">{{t 'lang.ACCEPT'}}</button>
            </form>
            <form method="post" action="/wardrobe-share/invite/{{this.inviteToken}}/decline">
              <button type="submit" class="btn btn-outline btn-sm h-auto min-h-(--size) max-w-full py-1.5" aria-describedby="pending-{{this.id}}">{{t 'lang.DECLINE'}}</button>
            </form>
          </div>
        </li>
        {{/each}}
      </ul>
    </div>
  </section>
  {{/if}}

  {{#if inbound.length}}
  <section class="card mb-6">
    <div class="card-body gap-2">
      <h2 class="card-title">{{t 'lang.SHARED_WITH_YOU'}}</h2>
      <ul role="list" class="divide-y divide-base-300">
        {{#each inbound}}
        <li class="grid gap-3 py-4 last:pb-0">
          <div class="flex flex-wrap items-center gap-2">
            <a id="inbound-{{this.id}}" href="/wardrobe?ownerId={{this.grantor.id}}" class="link link-primary font-medium wrap-anywhere">{{this.grantor.email}}</a>
            <span class="badge">{{#ifEquals this.permission 'MANAGE'}}{{t 'lang.PERMISSION_MANAGE'}}{{else}}{{t 'lang.PERMISSION_VIEW'}}{{/ifEquals}}</span>
          </div>
          <form method="post" action="/wardrobe-share/{{this.id}}/remove" hx-confirm="{{t 'lang.LEAVE_CONFIRM'}}">
            <button type="submit" class="btn btn-outline btn-sm h-auto min-h-(--size) max-w-full py-1.5" aria-describedby="inbound-{{this.id}}">{{icon "trash" class="size-4"}}{{t 'lang.LEAVE'}}</button>
          </form>
        </li>
        {{/each}}
      </ul>
    </div>
  </section>
  {{/if}}

  {{#unless outbound.length}}{{#unless inbound.length}}{{#unless pending.length}}
  {{> empty icon="share" text=(t 'lang.NO_SHARES_YET')}}
  {{/unless}}{{/unless}}{{/unless}}
</main>

{{>dock}}

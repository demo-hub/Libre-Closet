{{>navbar}}

<main id="main" tabindex="-1" class="page page--center">
  <div class="card w-full max-w-md">
    <div class="card-body gap-4">
      <h1>{{t 'lang.WARDROBE_INVITE'}}</h1>
      {{#if error}}
        {{> alert kind="error" text=message}}
        <a href="/" class="btn btn-primary">{{t 'lang.RETURN_TO_HOME'}}</a>
      {{else}}
        <p class="text-graphite">
          {{t 'lang.INVITE_FROM'}} <strong>{{grantorName}}</strong>
        </p>

        <div class="grid gap-2">
          <span class="badge">{{#ifEquals share.permission 'VIEW'}}{{t 'lang.PERMISSION_VIEW'}}{{else}}{{t 'lang.PERMISSION_MANAGE'}}{{/ifEquals}}</span>
          <p class="text-sm text-graphite">
            {{#ifEquals share.permission 'VIEW'}}
              {{t 'lang.INVITE_VIEW_DESC'}}
            {{else}}
              {{t 'lang.INVITE_MANAGE_DESC'}}
            {{/ifEquals}}
          </p>
        </div>

        {{#if isLoggedIn}}
          <div class="flex gap-2">
            <form method="post" action="/wardrobe-share/invite/{{token}}/accept" class="flex-1">
              <button type="submit" class="btn btn-primary w-full">{{t 'lang.ACCEPT'}}</button>
            </form>
            <form method="post" action="/wardrobe-share/invite/{{token}}/decline" class="flex-1">
              <button type="submit" class="btn btn-outline w-full">{{t 'lang.DECLINE'}}</button>
            </form>
          </div>
        {{else}}
          <div class="flex flex-col gap-2">
            <p class="text-sm text-graphite">{{t 'lang.INVITE_LOGIN_REQUIRED'}}</p>
            <a href="/auth/login" class="btn btn-primary">{{t 'lang.LOGIN'}}</a>
            {{#unless signupsDisabled}}
            <a href="/auth/register" class="btn btn-outline">{{t 'lang.REGISTER'}}</a>
            {{/unless}}
          </div>
        {{/if}}
      {{/if}}
    </div>
  </div>
</main>

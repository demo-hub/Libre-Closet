{{>navbar}}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": {{{json ogTitle}}},
    "description": {{{json ogDescription}}},
    "isPartOf": {
      "@id": "{{siteUrl}}/#website"
    }
  }
</script>

<main id="main" tabindex="-1" class="page page--center grid-cols-[minmax(0,24rem)] gap-4">
  <h1>{{t 'lang.REGISTER_OG_TITLE'}}</h1>
  {{#if error}}{{> alert kind="error" text=error}}{{/if}}
  <form method="post" action="/auth/register" hx-post="/auth/register" hx-target="main" hx-select="main" hx-swap="outerHTML" hx-indicator="#loading">
    <fieldset class="fieldset w-full border border-base-300 rounded-box p-4">
      {{!-- Only the fields are swapped on validation, so a press on the button is never lost to the swap. --}}
      <div class="contents" data-live-validation hx-post="/auth/validate/register" hx-target="this" hx-select="[data-live-validation]" hx-swap="outerHTML transition:false" hx-sync="this:replace" hx-trigger="change" hx-include="input" hx-indicator="#loading">
        {{> authField fieldId="email" type="email" label=(t 'lang.EMAIL') autocomplete="email" value=input.email errors=(filterErrors validationErrors 'email')}}
        {{> authField fieldId="password" type="password" label=(t 'lang.PASSWORD') autocomplete="new-password" value=input.password errors=(filterErrors validationErrors 'password')}}
        {{> authField fieldId="confirmPassword" type="password" label=(t 'lang.CONFIRM_PASSWORD') autocomplete="new-password" value=input.confirmPassword errors=(filterErrors validationErrors 'confirmPassword')}}
      </div>
      <button type="submit" class="btn btn-primary mt-4">{{t 'lang.REGISTER'}}</button>
    </fieldset>
  </form>
</main>

{{>dock}}

{{>navbar}}

<main id="main" tabindex="-1" class="page page--center">
  {{#if error}}
  <div class="toast toast-top toast-center">
    <div
      role="alert"
      class="alert alert-error shadow-lg"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6 shrink-0 stroke-current"
        fill="none"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"
        />
      </svg>
      <span>{{t 'lang.ERROR'}}</span>
    </div>
  </div>
  {{/if}}

  <form hx-post="/auth/reset" hx-target="main" hx-select="main" hx-swap="outerHTML" hx-indicator="#loading" hx-trigger="submit">
    <fieldset
      class="fieldset bg-base-200 border-base-300 rounded-box w-xs border p-4"
    >
      <legend class="fieldset-legend">{{t 'lang.RESET_PASSWORD'}}</legend>

      <label class="label">{{t 'lang.EMAIL'}}</label>
      <label class="input">
        <input
          name="email"
          type="email"
          value="{{input.email}}"
          placeholder="{{t 'lang.EMAIL'}}"
          required
        />
      </label>

      <button type="submit" class="btn btn-neutral mt-4">
        {{t 'lang.SEND_RESET_CODE'}}
      </button>
    </fieldset>
  </form>
</main>

{{>dock}}

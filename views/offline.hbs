{{>navbar}}

<main id="main" tabindex="-1" class="page page--center justify-items-center gap-2">
  <div class="flex flex-row items-center gap-2">
    <h1>{{t 'lang.OFFLINE_TITLE'}}</h1>
    {{icon "wifi-slash" class="size-6 text-error"}}
  </div>
  <p class="text-center">{{t 'lang.OFFLINE_DESC'}}</p>
  {{!-- Revealed by the script below: the page is served from the cache, so the server cannot know. --}}
  <div id="pendingShare" role="status" class="alert hidden max-w-sm">
    {{icon "information-circle" class="size-5 shrink-0"}}
    <div>{{t 'lang.SHARE_WAITING'}}</div>
    <a id="pendingShareLink" class="btn btn-outline btn-sm">{{t 'lang.SHARE_WAITING_OPEN'}}</a>
  </div>
  <a href="/" class="btn btn-primary">{{t 'lang.RETURN_TO_HOME'}}</a>
</main>

{{#if pwaEnabled}}
<script type="module">
  import { describePending, stashedShareUrl } from '/js/share-stash.js';

  const waiting = await describePending();
  if (waiting.length) {
    const notice = document.getElementById('pendingShare');
    const link = document.getElementById('pendingShareLink');
    link.href = stashedShareUrl(waiting[0].id);
    notice.classList.remove('hidden');
  }
</script>
{{/if}}

{{>dock}}

{{!-- Element ids are the contract of public/js/background-removal.js and test/camera-capture.spec.ts. Params: preview, submitLabel, submitBtnId. --}}
{{#if preview}}
<figure
  class="relative rounded-box overflow-hidden mb-2 bg-base-200 aspect-square w-full max-w-sm mx-auto flex items-center justify-center text-base-content/30"
>
  <img id="photoPreview" alt="" class="object-cover w-full h-full hidden" />
  <svg
    id="photoPreviewPlaceholder"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1"
    stroke="currentColor"
    class="size-20"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15M2.25 13.5h3.86a2.251 2.251 0 0 1 2.012 1.244l.256.512a2.251 2.251 0 0 0 2.013 1.244h3.218a2.251 2.251 0 0 0 2.013-1.244l.256-.512a2.251 2.251 0 0 1 2.013-1.244h3.859M12 3v8.25m0 0-3-3m3 3 3-3"
    />
  </svg>
</figure>
{{/if}}
  <input
    type="file"
    id="nobgPhotoInput"
    name="nobgPhoto"
    class="hidden"
    accept="image/webp"
  />
  <div class="flex gap-2 items-center">
    <input
      type="file"
      id="photoInput"
      name="photo"
      class="file-input file-input-sm flex-1"
      accept="image/jpeg,image/png,image/gif,image/webp"
    />
    <input
      type="file"
      id="photoCaptureInput"
      class="hidden"
      accept="image/jpeg,image/png,image/gif,image/webp"
      capture="environment"
    />
    <button
      id="photoCaptureBtn"
      type="button"
      class="btn btn-neutral btn-sm btn-square"
      title="{{t 'lang.TAKE_PHOTO'}}"
      aria-label="{{t 'lang.TAKE_PHOTO'}}"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-4"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.174C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-6.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z"
        />
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0ZM18.75 10.5h.008v.008h-.008V10.5Z"
        />
      </svg>
    </button>
    {{#if submitLabel}}
    <button id="photoBtn" class="btn btn-neutral btn-sm" disabled>
      {{submitLabel}}
    </button>
    <span
      id="loading"
      class="htmx-indicator loading loading-ring loading-sm"
    ></span>
    {{/if}}
  </div>
  <label class="flex items-center gap-2 cursor-pointer select-none">
    <input
      type="checkbox"
      id="bgRemovalToggle"
      class="toggle toggle-sm"
      checked
    />
    <span class="text-sm">{{t 'lang.BG_REMOVAL_TOGGLE'}}</span>
  </label>
  <div
    id="bgStatus"
    class="hidden flex flex-col gap-1 text-sm text-base-content/60"
    data-text-default="{{t 'lang.REMOVING_BACKGROUND'}}"
    data-text-downloading="{{t 'lang.BG_STAGE_DOWNLOADING'}}"
    data-text-decoding="{{t 'lang.BG_STAGE_DECODING'}}"
    data-text-inference="{{t 'lang.BG_STAGE_INFERENCE'}}"
    data-text-mask="{{t 'lang.BG_STAGE_MASK'}}"
    data-text-encoding="{{t 'lang.BG_STAGE_ENCODING'}}"
    data-text-hint-typical="{{t 'lang.BG_HINT_TYPICAL_DURATION'}}"
    data-text-hint-slow="{{t 'lang.BG_HINT_STILL_WORKING'}}"
  >
    <div class="flex items-center gap-2">
      <span class="loading loading-spinner loading-xs"></span>
      <span id="bgStatusText">{{t 'lang.REMOVING_BACKGROUND'}}</span>
    </div>
    <span id="bgStatusHint" class="text-xs opacity-80"
      >{{t 'lang.BG_HINT_TYPICAL_DURATION'}}</span
    >
  </div>
<script type="module">
  import { wireUpPhotoInput } from '/js/background-removal.js';

  const toggle = document.getElementById('bgRemovalToggle');
  const stored = localStorage.getItem('bgRemovalEnabled');
  toggle.checked = stored === null ? true : stored !== 'false';
  localStorage.setItem('bgRemovalEnabled', toggle.checked);

  toggle.addEventListener('change', () => {
    localStorage.setItem('bgRemovalEnabled', toggle.checked);
    const editBtn = document.getElementById('editMaskBtn');
    if (editBtn) editBtn.style.display = toggle.checked ? '' : 'none';

    if (toggle.checked) {
      const photoInput = document.getElementById('photoInput');
      if (photoInput?.files?.length) {
        photoInput.dispatchEvent(new Event('change'));
      }
    }
  });

  // Some Chrome/Android versions drop the Camera option from the gallery
  // file-input's chooser sheet depending on the `accept` value (see
  // https://github.com/lazztech/Libre-Closet/issues/99). A dedicated
  // input with `capture="environment"` sidesteps that by launching the
  // camera app directly, so route its selection into the same upload path.
  const photoCaptureBtn = document.getElementById('photoCaptureBtn');
  const photoCaptureInput = document.getElementById('photoCaptureInput');
  const photoInputEl = document.getElementById('photoInput');
  photoCaptureBtn?.addEventListener('click', () => photoCaptureInput?.click());
  photoCaptureInput?.addEventListener('change', () => {
    const file = photoCaptureInput.files?.[0];
    if (!file || !photoInputEl) return;
    const dt = new DataTransfer();
    dt.items.add(file);
    photoInputEl.files = dt.files;
    photoInputEl.dispatchEvent(new Event('change'));
  });

  const preview = document.getElementById('photoPreview');
  const showPreview = (blob) => {
    if (!preview) return;
    preview.src = URL.createObjectURL(blob);
    preview.classList.remove('hidden');
    document.getElementById('photoPreviewPlaceholder')?.classList.add('hidden');
  };

  wireUpPhotoInput({
    submitBtnId: '{{#if submitBtnId}}{{submitBtnId}}{{else}}photoBtn{{/if}}',
    onSelect: showPreview,
    onNobg: showPreview,
  });
</script>

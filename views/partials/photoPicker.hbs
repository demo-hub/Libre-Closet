{{!-- Element ids are the contract of public/js/background-removal.js and test/camera-capture.spec.ts. Params: preview, submitLabel, submitBtnId, previewSrc, hasAlpha. --}}
{{#if preview}}
<figure class="relative mx-auto mb-2 flex aspect-square w-full max-w-sm items-center justify-center overflow-hidden rounded-box bg-base-200">
  {{!-- An imported photo arrives already rendered, so it is visible before any
  script runs; the placeholder steps aside for it. --}}
  <img
    id="photoPreview"
    alt=""
    class="size-full object-contain{{#unless previewSrc}} hidden{{/unless}}"
    {{#if previewSrc}}src="{{previewSrc}}" data-has-alpha="{{hasAlpha}}"{{/if}}
  />
  <span id="photoPreviewPlaceholder" class="text-graphite{{#if previewSrc}} hidden{{/if}}">{{icon "tray" class="size-20"}}</span>
</figure>
{{/if}}
<input type="file" id="nobgPhotoInput" name="nobgPhoto" class="hidden" accept="image/webp" />
<div class="flex flex-wrap items-center gap-2">
  {{!-- The wrapper centres the 1 px input on its button, so the scroll margin takes the whole button clear of the bars when WebKit scrolls to it. --}}
  <div class="flex grow items-center">
    {{!-- sr-only, not hidden: ai-suggestions.spec asserts it visible, and its focus starts the model preload. --}}
    <input type="file" id="photoInput" name="photo" class="peer sr-only scroll-my-[calc(1.375rem+4px)]" accept="image/jpeg,image/png,image/gif,image/webp" />
    <label for="photoInput" class="btn btn-outline grow peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-focus">{{icon "photo" class="size-5"}}{{t 'lang.CHOOSE_PHOTO'}}</label>
  </div>
  <input type="file" id="photoCaptureInput" class="hidden" accept="image/jpeg,image/png,image/gif,image/webp" capture="environment" />
  <button id="photoCaptureBtn" type="button" class="btn btn-outline btn-square" title="{{t 'lang.TAKE_PHOTO'}}" aria-label="{{t 'lang.TAKE_PHOTO'}}">{{icon "camera" class="size-5"}}</button>
  {{#if submitLabel}}
  <div class="flex items-center gap-2">
    <button id="photoBtn" class="btn btn-primary" disabled>{{submitLabel}}</button>
    {{> spinner spinnerId="photoLoading" indicator=true}}
  </div>
  {{/if}}
</div>
{{#unless preview}}<p id="photoFileName" class="text-sm text-graphite wrap-anywhere" hidden></p>{{/unless}}
<label class="flex w-fit max-w-full cursor-pointer select-none items-start gap-2">
  <input type="checkbox" id="bgRemovalToggle" class="toggle shrink-0" checked />
  <span>{{t 'lang.BG_REMOVAL_TOGGLE'}}</span>
</label>
<div
  id="bgStatus"
  role="status"
  aria-live="polite"
  class="hidden flex flex-col gap-1 text-sm"
  data-text-default="{{t 'lang.REMOVING_BACKGROUND'}}"
  data-text-downloading="{{t 'lang.BG_STAGE_DOWNLOADING'}}"
  data-text-decoding="{{t 'lang.BG_STAGE_DECODING'}}"
  data-text-inference="{{t 'lang.BG_STAGE_INFERENCE'}}"
  data-text-mask="{{t 'lang.BG_STAGE_MASK'}}"
  data-text-encoding="{{t 'lang.BG_STAGE_ENCODING'}}"
  data-text-hint-typical="{{t 'lang.BG_HINT_TYPICAL_DURATION'}}"
  data-text-hint-slow="{{t 'lang.BG_HINT_STILL_WORKING'}}"
>
  <div class="flex items-center gap-2">
    {{> spinner decorative=true}}
    <span id="bgStatusText">{{t 'lang.REMOVING_BACKGROUND'}}</span>
  </div>
  <span id="bgStatusHint" class="text-graphite">{{t 'lang.BG_HINT_TYPICAL_DURATION'}}</span>
</div>
<script type="module">
  import { wireUpPhotoInput } from '/js/background-removal.js';
  import { suggestGarmentColors } from '/js/color-suggest.js';

  const toggle = document.getElementById('bgRemovalToggle');
  const stored = localStorage.getItem('bgRemovalEnabled');
  toggle.checked = stored === null ? true : stored !== 'false';
  localStorage.setItem('bgRemovalEnabled', toggle.checked);

  toggle.addEventListener('change', () => {
    localStorage.setItem('bgRemovalEnabled', toggle.checked);
    const editBtn = document.getElementById('editMaskBtn');
    if (editBtn) editBtn.style.display = toggle.checked ? '' : 'none';

    if (toggle.checked) {
      const photoInput = document.getElementById('photoInput');
      if (photoInput?.files?.length) {
        photoInput.dispatchEvent(new Event('change'));
      }
    }
  });

  // Some Chrome/Android versions drop the Camera option from the gallery
  // file-input's chooser sheet depending on the `accept` value (see
  // https://github.com/lazztech/Libre-Closet/issues/99). A dedicated
  // input with `capture="environment"` sidesteps that by launching the
  // camera app directly, so route its selection into the same upload path.
  const photoCaptureBtn = document.getElementById('photoCaptureBtn');
  const photoCaptureInput = document.getElementById('photoCaptureInput');
  const photoInputEl = document.getElementById('photoInput');
  const usePhoto = (file) => {
    if (!file || !photoInputEl) return;
    const dt = new DataTransfer();
    dt.items.add(file);
    photoInputEl.files = dt.files;
    photoInputEl.dispatchEvent(new Event('change'));
  };
  photoCaptureBtn?.addEventListener('click', () => photoCaptureInput?.click());
  photoCaptureInput?.addEventListener('change', () => usePhoto(photoCaptureInput.files?.[0]));

  // The real input is 1 px, so the button takes the drops a visible file input would.
  const chooseLabel = document.querySelector('label[for="photoInput"]');
  chooseLabel?.addEventListener('dragover', (e) => {
    if (e.dataTransfer?.types.includes('Files')) e.preventDefault();
  });
  chooseLabel?.addEventListener('drop', (e) => {
    const file = e.dataTransfer?.files?.[0];
    if (!file) return;
    e.preventDefault();
    if (photoInputEl?.accept.split(',').includes(file.type)) usePhoto(file);
  });

  const preview = document.getElementById('photoPreview');
  const showPreview = (blob) => {
    if (!preview) return;
    preview.src = URL.createObjectURL(blob);
    preview.classList.remove('hidden');
    document.getElementById('photoPreviewPlaceholder')?.classList.add('hidden');
  };

  const fileName = document.getElementById('photoFileName');

  wireUpPhotoInput({
    submitBtnId: '{{#if submitBtnId}}{{submitBtnId}}{{else}}photoBtn{{/if}}',
    onSelect: (file) => {
      showPreview(file);
      if (fileName) {
        fileName.textContent = file.name;
        fileName.hidden = false;
      }
    },
    onNobg: async (blob) => {
      showPreview(blob);
      // The cut-out is the only view of the garment with its background gone,
      // so this is the one moment its colours can be read.
      await suggestGarmentColors(blob);
    },
  });
</script>

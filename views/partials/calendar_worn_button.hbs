<form method="post" action="/calendar/{{entryId}}/worn"
    hx-post="/calendar/{{entryId}}/worn" hx-target="this" hx-swap="outerHTML settle:0ms transition:false">
    <input type="hidden" name="week" value="{{week}}" />
    <input type="hidden" name="worn" value="{{#if worn}}false{{else}}true{{/if}}" />
    <button type="submit" id="cal-worn-{{entryId}}" aria-pressed="{{#if worn}}true{{else}}false{{/if}}"
        class="btn btn-outline aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-content">
        {{#if worn}}{{icon "check-circle" class="size-5"}}{{else}}{{icon "circle" class="size-5"}}{{/if}}{{t 'lang.CALENDAR_WORN'}}
    </button>
</form>

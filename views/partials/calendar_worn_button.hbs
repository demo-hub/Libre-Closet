{{!-- The button stays in the page, so a screen reader's cursor stays on it; /js/calendar.js updates it from the answer. --}}
<form method="post" action="/calendar/{{entryId}}/worn" hx-post="/calendar/{{entryId}}/worn" hx-swap="none">
    <input type="hidden" name="week" value="{{week}}" />
    <input type="hidden" name="worn" value="{{#if worn}}false{{else}}true{{/if}}" />
    <button type="submit" aria-pressed="{{#if worn}}true{{else}}false{{/if}}"
        class="group btn btn-outline px-3 aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-content">
        {{icon "check-circle" class="hidden size-5 group-aria-pressed:block"}}{{icon "circle" class="size-5 group-aria-pressed:hidden"}}{{t 'lang.CALENDAR_WORN'}}
    </button>
</form>

<div
  class="form-control grid gap-1"
  data-color-field
  data-suggested-label="{{t 'lang.SUGGESTED'}}"
>
  <label class="label flex-wrap whitespace-normal" id="color-label-{{@index}}">{{t 'lang.COLOR'}}{{> suggestedBadge field='colors'}}</label>

  <details
    class="color-ms w-full min-w-0"
    id="color-ms-{{@index}}"
    data-placeholder="{{t 'lang.SELECT_COLOR'}}"
    data-selected-template="{{tRaw 'lang.COLORS_SELECTED'}}"
    data-remove-label="{{t 'lang.REMOVE'}}"
  >
    <summary aria-labelledby="color-label-{{@index}} color-summary-{{@index}}">
      <span class="ms-placeholder" id="color-summary-{{@index}}">{{t 'lang.SELECT_COLOR'}}</span>
      <svg class="ms-chevron" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
    </summary>

    <div class="ms-dropdown-anchor">
      <div class="ms-dropdown">
        <div class="ms-search">
          {{icon "magnifying-glass" class="size-4 shrink-0"}}
          <input type="text" class="ms-search-input" placeholder="{{t 'lang.SEARCH_OR_CREATE'}}" aria-label="{{t 'lang.SEARCH_OR_CREATE'}}" autocomplete="off">
        </div>
        <div class="ms-options">
          {{#each colors}}
          <label class="ms-option">
            <input type="checkbox" class="checkbox" name="color" value="{{this}}"
              {{#ifInArray this ../garment.color}}checked{{/ifInArray}}>
            <span class="ms-swatch ms-swatch--{{this}}"></span>
            <span class="capitalize">{{this}}</span>
          </label>
          {{/each}}
          {{#each customColors}}
          <label class="ms-option">
            <input type="checkbox" class="checkbox" name="color" value="{{this}}" checked>
            <span class="ms-swatch ms-swatch--other"></span>
            <span class="capitalize">{{this}}</span>
          </label>
          {{/each}}
        </div>
        <div class="ms-empty" hidden>{{t 'lang.NO_MATCHES'}}</div>
        <button type="button" class="ms-create" hidden>
          {{icon "plus" class="size-4 shrink-0"}}
          <span>{{t 'lang.CREATE'}} "<strong class="ms-create-label"></strong>"</span>
        </button>
        <div class="ms-footer">
          <span class="ms-count">0 {{t 'lang.SELECTED'}}</span>
          <button type="button" class="ms-clear">{{t 'lang.CLEAR_ALL'}}</button>
        </div>
      </div>
    </div>
  </details>

  {{!-- After the box, not inside its summary: a button in a summary fails axe nested-interactive, and above the box each new row would push the open list down. --}}
  <div class="ms-pills" id="color-pills-{{@index}}"></div>
</div>

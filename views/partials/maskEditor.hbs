{{!-- Mask editor dialog; ids are the contract of public/js/mask-editor.js. No backdrop form: a stray tap outside would throw the painting away. --}}
<dialog id="maskEditorDialog" class="modal" aria-labelledby="maskEditorTitle">
  <div class="modal-box flex flex-col gap-4">
    <h2 id="maskEditorTitle" class="text-h3">{{t 'lang.EDIT_MASK'}}</h2>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
      <div class="join join-vertical min-[25rem]:join-horizontal">
        <button id="maskBrushErase" type="button" class="btn btn-outline join-item btn-active aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-content" aria-pressed="true">{{t 'lang.MASK_BRUSH_ERASE'}}</button>
        <button id="maskBrushRestore" type="button" class="btn btn-outline join-item aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-content" aria-pressed="false">{{t 'lang.MASK_BRUSH_RESTORE'}}</button>
      </div>
      <div class="flex min-w-40 flex-1 items-center gap-3">
        <label for="maskBrushSize" class="shrink-0 text-sm text-graphite">{{t 'lang.MASK_BRUSH_SIZE'}}</label>
        <input id="maskBrushSize" type="range" min="4" max="80" value="20" class="range flex-1" />
      </div>
    </div>
    <canvas id="maskEditorCanvas" class="mask-frame"></canvas>
    <div class="modal-action mt-0 flex-wrap">
      <button id="maskEditorSkip" type="button" class="btn btn-outline">{{t 'lang.MASK_EDITOR_SKIP'}}</button>
      <button id="maskEditorAccept" type="button" class="btn btn-primary">{{t 'lang.MASK_EDITOR_ACCEPT'}}</button>
    </div>
  </div>
</dialog>

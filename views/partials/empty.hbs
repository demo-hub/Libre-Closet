{{!-- {{> empty icon="tray" text=… href=… cta=… [outline=true for a secondary action]}} --}}
<div class="flex flex-col items-center gap-4 py-16 text-center">
  {{icon this.icon class="size-16 text-haze"}}
  <p class="text-graphite">{{text}}</p>
  {{#if href}}<a href="{{href}}" class="btn {{#if outline}}btn-outline{{else}}btn-primary{{/if}}">{{cta}}</a>{{/if}}
</div>

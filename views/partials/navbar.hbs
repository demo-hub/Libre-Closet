<header class="app-header flex items-center gap-4">
  <a href="/" class="flex min-h-11 min-w-0 items-center gap-2">
    {{icon "hanger" class="size-7 shrink-0"}}
    <span class="font-heading text-h3 truncate">{{appName}}</span>
  </a>
  <nav class="hidden lg:flex items-center gap-1" aria-label="{{t 'lang.MAIN_NAVIGATION'}}">
    <a href="/wardrobe" class="btn btn-ghost"{{#ifEquals section "wardrobe"}} aria-current="page"{{/ifEquals}}>{{t 'lang.WARDROBE'}}</a>
    <a href="/outfits" class="btn btn-ghost"{{#ifEquals section "outfits"}} aria-current="page"{{/ifEquals}}>{{t 'lang.OUTFITS'}}</a>
    <a href="/calendar" class="btn btn-ghost"{{#ifEquals section "calendar"}} aria-current="page"{{/ifEquals}}>{{t 'lang.CALENDAR'}}</a>
  </nav>
  <div class="ml-auto flex shrink-0 items-center gap-2">
    {{> spinner spinnerId="loading" indicator=true}}
    {{#if authEnabled}}
      {{#if user}}
        <details class="dropdown dropdown-end">
          <summary class="btn btn-ghost">
            <span class="lg:hidden">{{icon "user" class="size-6"}}<span class="sr-only">{{t 'lang.ACCOUNT'}}</span></span>
            <span class="hidden lg:block max-w-56 truncate">{{user.email}}</span>
          </summary>
          <ul class="dropdown-content menu mt-1 w-56 rounded-box border border-base-300 bg-base-100 p-2">
            <li><a href="/auth/profile" class="min-h-11 content-center">{{t 'lang.PROFILE'}}</a></li>
            <li><a href="/auth/logout" class="min-h-11 content-center">{{t 'lang.LOGOUT'}}</a></li>
          </ul>
        </details>
      {{else}}
        {{!-- Two text buttons do not fit beside the name on a phone in every language, so below sm they share a menu. --}}
        <div class="hidden sm:flex items-center gap-1">
          <a href="/auth/login" class="btn btn-ghost">{{t 'lang.LOGIN'}}</a>
          {{#unless signupsDisabled}}<a href="/auth/register" class="btn btn-ghost">{{t 'lang.REGISTER'}}</a>{{/unless}}
        </div>
        <details class="dropdown dropdown-end sm:hidden">
          <summary class="btn btn-ghost btn-square">{{icon "user" class="size-6"}}<span class="sr-only">{{t 'lang.ACCOUNT'}}</span></summary>
          <ul class="dropdown-content menu mt-1 w-56 rounded-box border border-base-300 bg-base-100 p-2">
            <li><a href="/auth/login" class="min-h-11 content-center">{{t 'lang.LOGIN'}}</a></li>
            {{#unless signupsDisabled}}<li><a href="/auth/register" class="min-h-11 content-center">{{t 'lang.REGISTER'}}</a></li>{{/unless}}
          </ul>
        </details>
      {{/if}}
    {{/if}}
  </div>
</header>

{{>navbar}}

<main id="main" tabindex="-1" class="page page--center justify-items-center">
  <h1>{{t 'lang.ERROR'}} {{statusCode}}</h1>
  <p>{{message}}</p>
  <p><small>{{t 'lang.PATH'}}: {{path}}</small></p>
  <p><small>{{t 'lang.TIME'}}: {{timestamp}}</small></p>
  <a href="/" class="btn">{{t 'lang.RETURN_TO_HOME'}}</a>
</main>

{{>dock}}

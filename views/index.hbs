<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@id": "{{canonicalUrl}}#website",
    "@type": "WebSite",
    "name": {{{json appName}}},
    "url": "{{canonicalUrl}}",
    "description": {{{json (t 'lang.APP_DESCRIPTION')}}},
    "inLanguage": "{{locale}}",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "{{canonicalUrl}}wardrobe?keyword={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@id": "{{canonicalUrl}}#software",
    "@type": ["WebApplication", "SoftwareSourceCode"],
    "name": {{{json appName}}},
    "applicationCategory": "LifestyleApplication",
    "operatingSystem": "Linux, Web",
    "author": {
      "@type": "Organization",
      "name": "Lazztech LLC"
    },
    "image": "{{ogImage}}",
    "codeRepository": {{{json sourceUrl}}},
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "url": "{{canonicalUrl}}",
    "description": {{{json (t 'lang.APP_DESCRIPTION')}}},
    "license": "https://www.gnu.org/licenses/agpl-3.0.html",
    "featureList": "{{canonicalUrl}}#features"
  }
</script>

{{>navbar}}

<main id="main" tabindex="-1" class="page grid gap-16">
  <section class="grid justify-items-center gap-4 rounded-box border border-base-300 px-4 py-8 text-center sm:gap-6 sm:px-8 sm:py-16">
    {{icon "hanger" class="size-12 sm:size-16"}}
    <span class="badge h-auto min-h-7 py-1 text-balance">{{t 'lang.OPEN_SOURCE_BADGE'}}</span>
    <h1 class="max-w-3xl text-h1 text-balance hyphens-auto sm:text-display">{{t 'lang.TAGLINE'}}</h1>
    <p class="max-w-2xl text-graphite sm:text-lg">{{t 'lang.HERO_DESCRIPTION'}}</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/wardrobe" class="btn btn-primary btn-lg">{{t 'lang.GET_STARTED'}}</a>
      {{#if authEnabled}}{{#unless user}}{{#unless signupsDisabled}}
      <a href="/auth/register" class="btn btn-outline btn-lg">{{t 'lang.REGISTER'}}</a>
      {{/unless}}{{/unless}}{{/if}}
      <a href="{{sourceUrl}}" target="_blank" rel="noopener" hx-boost="false" class="btn btn-outline btn-lg">{{t 'lang.SOURCE_ON_GITHUB'}}</a>
    </div>
  </section>

  <section id="features" class="grid gap-6">
    <h2>{{t 'lang.FEATURES_TITLE'}}</h2>
    <ul role="list" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <li class="card">
        <div class="card-body">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="size-8"><path d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 0 1 0 3.75H5.625a1.875 1.875 0 0 1 0-3.75Z"/></svg>
          <h3 class="card-title">{{t 'lang.FEATURE_OUTFITS_TITLE'}}</h3>
          <p class="text-graphite">{{t 'lang.FEATURE_OUTFITS_DESC'}}</p>
        </div>
      </li>
      <li class="card">
        <div class="card-body">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="size-8"><path d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z"/></svg>
          <h3 class="card-title">{{t 'lang.FEATURE_SCHEDULING_TITLE'}}</h3>
          <p class="text-graphite">{{t 'lang.FEATURE_SCHEDULING_DESC'}}</p>
        </div>
      </li>
      <li class="card">
        <div class="card-body">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="size-8"><path d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z"/></svg>
          <h3 class="card-title">{{t 'lang.FEATURE_BG_REMOVAL_TITLE'}}</h3>
          <p class="text-graphite">{{t 'lang.FEATURE_BG_REMOVAL_DESC'}}</p>
        </div>
      </li>
      <li class="card">
        <div class="card-body">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="size-8"><path d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z"/><path d="M6 6h.008v.008H6V6Z"/></svg>
          <h3 class="card-title">{{t 'lang.FEATURE_CATEGORIES_TITLE'}}</h3>
          <p class="text-graphite">{{t 'lang.FEATURE_CATEGORIES_DESC'}}</p>
        </div>
      </li>
      <li class="card">
        <div class="card-body">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="size-8"><path d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/></svg>
          <h3 class="card-title">{{t 'lang.FEATURE_PRIVACY_TITLE'}}</h3>
          <p class="text-graphite">{{t 'lang.FEATURE_PRIVACY_DESC'}}</p>
        </div>
      </li>
      <li class="card">
        <div class="card-body">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="size-8"><path d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 8.25h3m-3 3.75h3m-3 3.75h3"/></svg>
          <h3 class="card-title">{{t 'lang.FEATURE_PWA_TITLE'}}</h3>
          <p class="text-graphite">{{t 'lang.FEATURE_PWA_DESC'}}</p>
        </div>
      </li>
      <li class="card">
        <div class="card-body">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="size-8"><path d="M21.75 17.25v-.228a4.5 4.5 0 0 0-.12-1.03l-2.268-9.64a3.375 3.375 0 0 0-3.285-2.602H7.923a3.375 3.375 0 0 0-3.285 2.602l-2.268 9.64a4.5 4.5 0 0 0-.12 1.03v.228m19.5 0a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3m19.5 0a3 3 0 0 0-3-3H5.25a3 3 0 0 0-3 3m16.5 0h.008v.008h-.008v-.008Zm-3 0h.008v.008h-.008v-.008Z"/></svg>
          <h3 class="card-title">{{t 'lang.FEATURE_DOCKER_TITLE'}}</h3>
          <p class="text-graphite">{{t 'lang.FEATURE_DOCKER_DESC'}}</p>
        </div>
      </li>
      <li class="card">
        <div class="card-body">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="size-8"><path d="M10.5 21l5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"/></svg>
          <h3 class="card-title">{{t 'lang.FEATURE_I18N_TITLE'}}</h3>
          <p class="text-graphite">{{t 'lang.FEATURE_I18N_DESC'}}</p>
        </div>
      </li>
      <li class="card">
        <div class="card-body">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="size-8"><path d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.935-2.185 2.25 2.25 0 0 0-3.935 2.185Z"/></svg>
          <h3 class="card-title">{{t 'lang.FEATURE_SHARING_TITLE'}}</h3>
          <p class="text-graphite">{{t 'lang.FEATURE_SHARING_DESC'}}</p>
        </div>
      </li>
    </ul>
  </section>

  <section class="grid gap-6">
    <h2 id="screenshots-title">{{t 'lang.SCREENSHOTS_TITLE'}}</h2>
    <div role="region" aria-labelledby="screenshots-title" tabindex="0" class="snap-x snap-mandatory overflow-x-auto pb-2">
      <ul role="list" class="flex w-max gap-4">
        <li class="snap-start">
          <figure class="grid w-56 gap-2">
            <img src="/assets/screenshots/Screenshot_mobile_1.webp" alt="{{t 'lang.SCREENSHOT_WARDROBE_ALT'}}" width="1179" height="2556" loading="lazy" class="h-auto w-full rounded-box border border-base-300" />
            <figcaption class="text-sm text-graphite">{{t 'lang.SCREENSHOT_WARDROBE_CAPTION'}}</figcaption>
          </figure>
        </li>
        <li class="snap-start">
          <figure class="grid w-56 gap-2">
            <img src="/assets/screenshots/Screenshot_mobile_2.webp" alt="{{t 'lang.SCREENSHOT_GARMENT_ALT'}}" width="1179" height="2556" loading="lazy" class="h-auto w-full rounded-box border border-base-300" />
            <figcaption class="text-sm text-graphite">{{t 'lang.SCREENSHOT_GARMENT_CAPTION'}}</figcaption>
          </figure>
        </li>
        <li class="snap-start">
          <figure class="grid w-56 gap-2">
            <img src="/assets/screenshots/Screenshot_mobile_3.webp" alt="{{t 'lang.SCREENSHOT_OUTFIT_BUILDER_ALT'}}" width="1179" height="2556" loading="lazy" class="h-auto w-full rounded-box border border-base-300" />
            <figcaption class="text-sm text-graphite">{{t 'lang.SCREENSHOT_OUTFIT_BUILDER_CAPTION'}}</figcaption>
          </figure>
        </li>
        <li class="snap-start">
          <figure class="grid w-56 gap-2">
            <img src="/assets/screenshots/Screenshot_mobile_4.webp" alt="{{t 'lang.SCREENSHOT_OUTFIT_ALT'}}" width="1179" height="2556" loading="lazy" class="h-auto w-full rounded-box border border-base-300" />
            <figcaption class="text-sm text-graphite">{{t 'lang.SCREENSHOT_OUTFIT_CAPTION'}}</figcaption>
          </figure>
        </li>
      </ul>
    </div>
  </section>

  <section class="grid max-w-3xl gap-4">
    <h2>{{t 'lang.WHY_SELF_HOST_TITLE'}}</h2>
    <p>{{t 'lang.WHY_SELF_HOST_DESC'}}</p>
    <p>{{t 'lang.WHY_SELF_HOST_DESC_2'}}</p>
  </section>

  <section class="grid max-w-3xl gap-4">
    <h2>{{t 'lang.SELF_HOST_TITLE'}}</h2>
    <p>{{t 'lang.SELF_HOST_DESC'}}</p>
    <pre class="code-block"><code>docker run -d \
  -p 3000:3000 \
  -v librecloset_data:/app/data \
  {{imageName}}</code></pre>
    <button
      type="button"
      class="btn btn-outline hidden justify-self-start"
      aria-live="polite"
      data-copy="docker run -d -p 3000:3000 -v librecloset_data:/app/data {{imageName}}"
      data-done="{{t 'lang.COPIED'}}"
      data-label="{{t 'lang.COPY_COMMAND'}}"
      _="init if navigator.clipboard then remove .hidden from me end
         on click
           call navigator.clipboard.writeText(my @data-copy)
           put my @data-done into the first <span/> in me
           wait 2s
           put my @data-label into the first <span/> in me"
    ><span>{{t 'lang.COPY_COMMAND'}}</span></button>
    <p class="text-sm text-graphite">{{t 'lang.SELF_HOST_NOTE'}}</p>
  </section>

  <footer class="grid justify-items-center gap-3 border-t border-base-300 pt-8 text-center text-sm text-graphite">
    <p class="flex items-center gap-2 font-semibold text-base-content">{{icon "hanger" class="size-5"}}{{appName}}</p>
    <p class="max-w-2xl">{{t 'lang.FOOTER_CREDIT'}}</p>
    <nav>
      <ul role="list" class="flex flex-wrap justify-center gap-x-3">
        <li><a href="{{sourceUrl}}" target="_blank" rel="noopener" hx-boost="false" class="link inline-flex min-h-6 items-center px-1 text-xs pointer-coarse:min-h-11">{{t 'lang.SOURCE_CODE'}}</a></li>
        <li><a href="/about" class="link inline-flex min-h-6 items-center px-1 text-xs pointer-coarse:min-h-11">{{t 'lang.ABOUT'}}</a></li>
        <li><a href="/privacy" class="link inline-flex min-h-6 items-center px-1 text-xs pointer-coarse:min-h-11">{{t 'lang.PRIVACY'}}</a></li>
        <li><a href="/terms" class="link inline-flex min-h-6 items-center px-1 text-xs pointer-coarse:min-h-11">{{t 'lang.TERMS'}}</a></li>
      </ul>
    </nav>
  </footer>
</main>

{{>dock}}

{{>navbar}}

<main id="main" tabindex="-1" class="page">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h1>{{t 'lang.OUTFITS'}}</h1>
    {{#if outfits.length}}
    <a href="/outfits/new" class="btn btn-primary">{{icon "plus" class="size-5"}}{{t 'lang.BUILD_OUTFIT'}}</a>
    {{/if}}
  </div>

  {{#if outfits.length}}
  <ul role="list" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {{#each outfits}}
    <li class="relative">
      <a href="/outfits/{{this.id}}" class="card h-full hover:border-steel" aria-labelledby="outfit-{{this.id}}-title">
        <div class="card-body gap-2">
          <p id="outfit-{{this.id}}-title" class="card-title flex-none pe-12 hyphens-auto wrap-anywhere">{{#if this.name}}{{this.name}}{{else}}{{t 'lang.UNTITLED_OUTFIT'}}{{/if}}</p>
          {{#if this.notes}}<p class="line-clamp-2 flex-none text-sm text-graphite wrap-anywhere">{{this.notes}}</p>{{/if}}
          <div class="flex flex-wrap gap-2">
            {{#each this.garments}}
            {{#if this.photo}}
            <img src="/file/nobg/{{this.photo.fileName}}" alt="" class="size-16 rounded-box object-contain sm:size-20" />
            {{else}}
            <span class="flex size-16 items-center justify-center rounded-box bg-base-200 text-graphite sm:size-20">{{icon "hanger" class="size-6"}}</span>
            {{/if}}
            {{/each}}
          </div>
        </div>
      </a>
      {{!-- Outside the link: a control inside it would be nested interactive content. --}}
      <details class="dropdown dropdown-end absolute end-2 top-2">
        <summary class="btn btn-ghost btn-circle" aria-label="{{t 'lang.ADD_TO_CALENDAR'}}">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z" /></svg>
        </summary>
        <div class="dropdown-content z-10 mt-1 w-64 max-w-[calc(100vw-2rem)] rounded-box border border-base-300 bg-base-100 p-4">
          <form
            hx-post="/calendar"
            hx-swap="none"
            hx-push-url="false"
            class="grid gap-2"
            _="on every htmx:afterRequest[detail.successful]
                 reset me
                 js(me)
                   const menu = me.closest('details');
                   menu.open = false;
                   menu.querySelector('summary').focus();
                   const status = document.getElementById('calendar-status');
                   status.textContent = '';
                   requestAnimationFrame(() => { status.textContent = me.dataset.done; });
                 end
                 remove .hidden from #calendar-toast
                 wait 3s
                 add .hidden to #calendar-toast
                 set #calendar-status's textContent to ''"
            data-done="{{t 'lang.CALENDAR_OUTFIT_ADDED'}}"
          >
            <input type="hidden" name="outfitId" value="{{this.id}}" />
            <label for="outfit-date-{{this.id}}" class="label flex-wrap whitespace-normal">{{t 'lang.CALENDAR_ADD_OUTFIT_PROMPT'}}</label>
            <input type="date" id="outfit-date-{{this.id}}" name="date" class="input input-sm w-full" required />
            <button type="submit" class="btn btn-primary btn-sm w-full">{{t 'lang.SAVE'}}</button>
          </form>
        </div>
      </details>
    </li>
    {{/each}}
  </ul>
  {{else}}
  {{> empty icon="hanger" text=(t 'lang.NO_OUTFITS') href="/outfits/new" cta=(t 'lang.ADD_FIRST_OUTFIT')}}
  {{/if}}
  {{!-- The toast is shown from display: none, which screen readers rarely announce; this region says it instead. --}}
  <p id="calendar-status" class="sr-only" role="status"></p>
</main>

{{> toast id="calendar-toast" kind="success" text=(t 'lang.CALENDAR_OUTFIT_ADDED') hidden=true silent=true}}

{{>dock}}

{{>navbar}}

<main id="main" tabindex="-1" class="page page--narrow">
  <div class="mb-6 flex items-start gap-2">
    <a href="/outfits" class="btn btn-ghost btn-circle" aria-label="{{t 'lang.BACK'}}">{{icon "arrow-left" class="size-5"}}</a>
    <h1 class="min-w-0 flex-1 hyphens-auto wrap-anywhere">{{#if outfit.name}}{{outfit.name}}{{else}}{{t 'lang.UNTITLED_OUTFIT'}}{{/if}}</h1>
  </div>

  {{#if outfit.notes}}
  <p class="mb-6 whitespace-pre-line text-graphite wrap-anywhere">{{outfit.notes}}</p>
  {{/if}}

  <h2 class="mb-3 text-h3">{{t 'lang.GARMENTS_IN_OUTFIT'}}</h2>
  {{#if garments.length}}
  <ul role="list" class="mb-8 grid grid-cols-3 gap-3 sm:grid-cols-4">
    {{#each garments}}
    <li>
      <a href="/wardrobe/{{this.id}}" class="flex flex-col items-center gap-1 rounded-box text-center">
        {{#if this.photo}}
        <img src="/file/nobg/{{this.photo.fileName}}" alt="" class="aspect-square w-full rounded-box bg-base-200 object-contain" />
        {{else}}
        <span class="flex aspect-square w-full items-center justify-center rounded-box bg-base-200 text-graphite">{{icon "hanger" class="size-8"}}</span>
        {{/if}}
        <span class="line-clamp-2 text-sm hyphens-auto wrap-anywhere">{{this.label}}</span>
      </a>
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="mb-8 text-graphite">{{t 'lang.NO_GARMENTS_IN_OUTFIT'}}</p>
  {{/if}}

  <div class="grid gap-2 border-t border-base-300 pt-6 sm:grid-cols-3">
    <a href="/outfits/{{outfit.id}}/edit?returnTo=/outfits/{{outfit.id}}" class="btn btn-outline">{{icon "pencil" class="size-5"}}{{t 'lang.EDIT'}}</a>
    <button
      type="button"
      class="btn btn-outline"
      aria-live="polite"
      data-copy="{{siteUrl}}/share?shareableId={{outfit.shareableId}}&type=outfit"
      data-done="{{t 'lang.COPIED'}}"
      data-label="{{t 'lang.SHARE'}}"
      _="on click
           call navigator.clipboard.writeText(my @data-copy)
           put my @data-done into the first <span/> in me
           wait 2s
           put my @data-label into the first <span/> in me"
    >{{icon "share" class="size-5"}}<span>{{t 'lang.SHARE'}}</span></button>
    <button
      type="button"
      class="btn btn-outline"
      hx-delete="/outfits/{{outfit.id}}"
      hx-confirm="{{t 'lang.CONFIRM_DELETE'}}"
      hx-indicator="#loading"
    >{{icon "trash" class="size-5"}}{{t 'lang.DELETE_OUTFIT'}}</button>
  </div>
</main>

{{>dock}}

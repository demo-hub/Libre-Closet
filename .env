# Import a garment from a link. The server fetches the page you paste.
#IMPORT_URL_ENABLED=false
#IMPORT_URL_RATE_LIMIT=10
# Development and testing only: lets the fetcher reach private and loopback
# addresses on any port. Cloud metadata stays blocked regardless.
#IMPORT_ALLOW_PRIVATE_NETWORKS=true
#IMPORT_FETCH_TIMEOUT_MS=10000
# Optional AI suggestions. Off unless AI_PROVIDER names one.
# A local vision model, which needs no key and sends nothing off the network:
# AI_MODEL is required for these two, and has to be a model that can see.
#AI_PROVIDER=ollama
#AI_MODEL=qwen2.5vl:7b
# Elsewhere on the network, or llama.cpp / vLLM / LM Studio / OpenAI:
#AI_PROVIDER=openai
#AI_BASE_URL=http://192.168.1.5:11434/v1
#AI_MODEL=qwen2.5vl:7b
# Or a hosted model:
#AI_PROVIDER=anthropic
#AI_API_KEY=sk-ant-...
#AI_MODEL=claude-opus-5
# A vision model on CPU can take a minute or more.
#AI_TIMEOUT_MS=30000
